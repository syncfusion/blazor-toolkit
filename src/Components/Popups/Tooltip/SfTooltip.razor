@namespace Syncfusion.Blazor.Toolkit.Popups
@using Syncfusion.Blazor;
@using Microsoft.AspNetCore.Components;
@inherits SfBaseComponent
@using System.Text.Encodings.Web


@*Tooltip element*@
<div id="@ID" @ref="_tooltipElement" @attributes="@_attributes">
    <CascadingValue Value="@this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@*Dynamically generating tooltip element on JSInterop server method call*@
@if (_renderWrapper)
{
    <div id="@(ID)_content_placeholder" class="@TOOLTIPCONTENTPLACEHOLDER">
        <div id="@(ID)_content" class="@TOOLTIPCONTENTCLASS @CssClass" role="tooltip" aria-hidden="false" aria-live="polite" aria-atomic="true" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" aria-describedby="@AriaDescribedBy">
            <div class="@TOOLTIPCONTENT">
                @if (!string.IsNullOrEmpty(Content))
                {
                    @Content
                }
                else if (ContentTemplate != null)
                {
                    @ContentTemplate
                }
            </div>
            @if (ShowTipPointer)
            {
                <div class="@ARRORTIP">
                    <div class="@ARROWTIPOUTER"></div>
                    <div class="@ARROWIPINNER"></div>
                </div>
            }
            @if (IsSticky)
            {
                <button type="button" class="@CLOSEICON" aria-label="@Localizer["CloseTooltip"]" title="@Localizer["CloseTooltip"]" @onclick="@StickyCloseAsync" @onkeydown="@StickyCloseKeyDownAsync"></button>
            }
        </div>
    </div>
}