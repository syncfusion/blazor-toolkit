@namespace Syncfusion.Blazor.Toolkit
@using Syncfusion.Blazor.Toolkit;

@inherits SfSelectionBase<TChecked>
@typeparam TChecked

@* Shared theme emitter: render-time, sibling placed BEFORE the root element. *@
<SfThemeRoot />
<div class="@_rootClass">
    <input @ref="_input"
    id="@_idValue"
    class="@RadioButtonClass"
    type="@InputType"
    name="@Name"
    value="@Value"
    checked="@_isChecked"
    disabled="@Disabled"
    aria-label="@GetAriaLabelValue()"
    @onclick="@HandleClickAsync"
    @attributes="@_inputAttributes" />
    <label for="@_idValue" class="@_labelClass">
        <span class="@LabelClass">@Label</span>
    </label>
</div>
