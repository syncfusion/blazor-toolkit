@namespace Syncfusion.Blazor.Toolkit.Charts.Internal
@inherits SvgClass

@*
    MS-4.10 — The `style="@Style"` attribute is intentionally retained.
    `Style` is a public `[Parameter]` on `SvgRect` that callers use to
    append chart-driven runtime CSS (per-series fill, dash, animation
    timing, etc.). Such per-instance data cannot be expressed
    statically in `SvgRect.razor.css`. Static / theme rules that
    apply on every render live in the colocated `.razor.css` file.
*@
