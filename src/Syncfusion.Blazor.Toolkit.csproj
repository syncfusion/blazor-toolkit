<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<!-- NuGet package metadata and assembly (DLL) properties -->
	<Version>1.0.0</Version>
	<PackageId>Syncfusion.Blazor.Toolkit</PackageId>
	<Product>Syncfusion Blazor Toolkit Components</Product>
	<Authors>Syncfusion Inc.</Authors>
	<IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	<!-- Copyright year is derived from the build clock so the stamp advances automatically each year. -->
	<Copyright>Copyright 2001 - $([System.DateTime]::UtcNow.Year) Syncfusion® Inc.</Copyright>
	<Title>Syncfusion Blazor Toolkit Components</Title>
	<PackageDescription>The Syncfusion® Toolkit for Blazor is a high-performance, open-source collection of lightweight UI components designed to accelerate Blazor application development (Server and WebAssembly). These controls help developers build modern, responsive, and feature-rich web applications faster, with clean code and excellent performance.</PackageDescription>
	<PackageIcon>syncfusion_logo.png</PackageIcon>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<ProjectUrl>https://github.com/syncfusion/blazor-toolkit</ProjectUrl>
	<PackageProjectUrl>https://www.syncfusion.com/blazor-toolkit</PackageProjectUrl>
	<RepositoryUrl>https://github.com/syncfusion/blazor-toolkit.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<RepositoryCommit>$(SourceRevisionId)</RepositoryCommit>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<!-- Release notes point to the GitHub release page; see DEVELOPMENT.md §Versioning and API stability. -->
	<PackageReleaseNotes>See https://github.com/syncfusion/blazor-toolkit/releases for the full release notes for this version.</PackageReleaseNotes>
	<PackageTags>
		syncfusion;blazor;toolkit
	</PackageTags>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	<!-- Generates XML documentation file from code comments at compile time -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>	
	<!-- IL Linker may break reflection; uncomment if trimming issues occur -->
	<!--<BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>-->

    <!-- Compiler and code analysis configuration -->
	<Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-All</AnalysisLevel>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	<AnalysisMode>All</AnalysisMode>
	<NuGetAudit>true</NuGetAudit>
	<NuGetAuditLevel>moderate</NuGetAuditLevel>
	<NuGetAuditMode>all</NuGetAuditMode>
	<!--
		Promote only the security-relevant analyzers to errors so the build
		fails fast on hardening regressions. We deliberately DO NOT promote
		usage / design / performance-style rules (CA1xxx naming, CA18xxx
		collection read-only, CA2xxx reliability other than the few listed,
		etc.) because the codebase has pre-existing CA findings in those
		families that are unrelated to security. The CI build keeps running
		the full analyzer set (warning level), and Security-focused rules
		gate compilation. Each ID below is one of:
		  - CA5352 / CA5353 / CA5354 / CA5355 / CA5356 / CA5360 / CA5361 /
		    CA5362 / CA5363 / CA5364 / CA5368 / CA5369 / CA5370 / CA5371 /
		    CA5372 / CA5373 / CA5374 / CA5375 / CA5376 / CA5377 / CA5378 /
		    CA5379 / CA5380 / CA5381 / CA5382 / CA5383 / CA5384 / CA5385 /
		    CA5386 / CA5387 / CA5388 / CA5389 / CA5390 / CA5391 / CA5392 /
		    CA5393 / CA5394 / CA5395 / CA5396 / CA5397 / CA5398 / CA5399 /
		    CA5400 / CA5401 / CA5402 / CA5403 / CA5404 / CA5405
		    (Security / Cryptography rules)
		  - CA2300..CA2399 covers Insecure Deserialization BiDi etc.
		  - CA2100 SQL injection, CA2150/CA2151 insecure crypto primitives.
	-->
	<WarningsAsErrors>CA2100;CA2102;CA2103;CA2108;CA2115;CA2116;CA2117;CA2118;CA2134;CA2136;CA2143;CA2144;CA2146;CA2147;CA2149;CA2150;CA2151;CA2152;CA2153;CA2154;CA2155;CA2156;CA2157;CA2158;CA2159;CA2300;CA2301;CA2302;CA2303;CA2304;CA2305;CA2306;CA2307;CA2308;CA2309;CA2310;CA2311;CA2312;CA2313;CA2314;CA2315;CA2316;CA2317;CA2318;CA2319;CA2320;CA2321;CA2322;CA2323;CA2324;CA2325;CA2326;CA2327;CA2328;CA2329;CA2330;CA2331;CA2332;CA2333;CA2334;CA2335;CA2336;CA2337;CA2338;CA2339;CA2340;CA2341;CA2342;CA2343;CA2344;CA2345;CA2346;CA2347;CA2348;CA2349;CA2350;CA2351;CA2352;CA2353;CA2354;CA2355;CA2356;CA2357;CA2358;CA2359;CA2360;CA2361;CA2362;CA2363;CA2364;CA2365;CA2366;CA2367;CA2368;CA2369;CA2370;CA2371;CA2372;CA2373;CA2374;CA2375;CA2376;CA2377;CA2378;CA2379;CA2380;CA2381;CA2382;CA2383;CA2384;CA2385;CA2386;CA2387;CA2388;CA2389;CA2390;CA2391;CA2392;CA2393;CA2394;CA2395;CA2396;CA2397;CA2398;CA2399;CA3075;CA3076;CA3077;CA5350;CA5351;CA5352;CA5353;CA5354;CA5355;CA5356;CA5357;CA5358;CA5359;CA5360;CA5361;CA5362;CA5363;CA5364;CA5365;CA5366;CA5367;CA5368;CA5369;CA5370;CA5371;CA5372;CA5373;CA5374;CA5375;CA5376;CA5377;CA5378;CA5379;CA5380;CA5381;CA5382;CA5383;CA5384;CA5385;CA5386;CA5387;CA5388;CA5389;CA5390;CA5391;CA5392;CA5393;CA5394;CA5395;CA5396;CA5397;CA5398;CA5399;CA5400;CA5401;CA5402;CA5403;CA5404;CA5405</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
	<None Include="syncfusion_logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
	<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
	<None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
	
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

	<PropertyGroup>
		<ComponentsPackageVersion Condition="'$(TargetFramework)'=='net8.0'">8.0.23</ComponentsPackageVersion>
		<ComponentsPackageVersion Condition="'$(TargetFramework)'=='net9.0'">9.0.12</ComponentsPackageVersion>
		<ComponentsPackageVersion Condition="'$(TargetFramework)'=='net10.0'">10.0.2</ComponentsPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="$(ComponentsPackageVersion)" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="$(ComponentsPackageVersion)" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

  <Target Name="RunGulpOnceBeforeBuild" BeforeTargets="BeforeBuild" Condition="$(TargetFramework) == $(TargetFrameworks.Split(';')[0]) AND !Exists('wwwroot/styles/fluent.min.css')">
	<Message Importance="high" Text="Installing npm packages and running blazor-toolkit-themes gulp task for the first time..." />
	<Exec Command="npm install" />
	<Exec Command="gulp blazor-toolkit-themes" />
  </Target>
</Project>
