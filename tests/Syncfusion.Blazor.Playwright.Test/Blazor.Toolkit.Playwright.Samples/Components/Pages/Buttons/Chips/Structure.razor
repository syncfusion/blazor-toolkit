@page "/chips/structure"
@rendermode InteractiveServer
@layout MainLayout

<span id="structure-ready" data-ready="true" hidden></span>

<h1>Chips - selection structure</h1>

<section id="chip-filter-selected">
    <SfChip ChipType="ChipType.Filter" Selected="true" Text="Sale" />
</section>

<section id="chip-choice-selected">
    <SfChip ChipType="ChipType.Choice" Selected="true" Text="One" />
</section>

<section id="chip-filter-clear">
    <SfChip ChipType="ChipType.Filter" Text="Clear" />
</section>

<section id="chip-action-selected">
    <SfChip ChipType="ChipType.Action" Selected="true" Text="Go" />
</section>

<section id="chip-input-selected">
    <SfChip ChipType="ChipType.Input" Selected="true" Text="Token" />
</section>

<section id="chip-filter-icon">
    <SfChip ChipType="ChipType.Filter" Selected="true" Text="Leaf" IconCss="e-icons e-leaf" />
</section>

<section id="chip-filter-template">
    <SfChip ChipType="ChipType.Filter" Selected="true" Text="Author">
        <LeadingTemplate>
            <span class="e-icons e-user" data-testid="author-leading"></span>
        </LeadingTemplate>
    </SfChip>
</section>

<section id="chip-remove-filled">
    <SfChip Text="Filled" Removable="true" CssClass="e-primary" />
</section>

<section id="chip-remove-soft">
    <SfChip Text="Soft" Removable="true" CssClass="e-chip-soft e-primary" />
</section>

<section id="chip-remove-outlined">
    <SfChip Text="Outlined" Removable="true" Variant="ChipVariant.Outlined" CssClass="e-primary" />
</section>

<section id="chip-filter-soft">
    <SfChip ChipType="ChipType.Filter" Selected="true" Text="Soft" CssClass="e-chip-soft e-primary" />
</section>

<section id="chip-filter-outlined">
    <SfChip ChipType="ChipType.Filter" Selected="true" Text="Outlined" Variant="ChipVariant.Outlined" CssClass="e-primary" />
</section>

<section id="chip-filter-rtl" dir="rtl">
    <SfChip ChipType="ChipType.Filter" Selected="true" Removable="true" EnableRtl="true" Text="Right" />
</section>

<section id="chipset-collapse">
    <SfChipSet TItem="string"
               DataSource="@_collapse"
               ChipType="ChipType.Filter"
               SelectionMode="ChipSelectionMode.Single"
               OverflowMode="ChipOverflowMode.Collapse"
               CollapsedVisibleCount="4"
               SelectedValue="@_collapse[0]" />
</section>

@code {
    private readonly string[] _collapse = ["Alpha", "Beta", "Gamma", "Delta"];
}
