@page "/toolbar/keyboard"
@using Microsoft.AspNetCore.Components.Web

@layout MainLayout

<span id="interactive-ready" data-ready="@(_interactiveReady ? "true" : "false")" hidden></span>

<h1>Toolbar - Keyboard</h1>

<div class="test-container" dir="@(Rtl ? "rtl" : "ltr")">
    <button id="before-toolbar" type="button">Before</button>
    <SfToolbar Id="toolbar-keys" AriaLabel="Keyboard commands" EnableRtl="@(Rtl ? true : null)" OnItemClick="OnItemClick">
        <ToolbarItem Id="k-one" Text="One" />
        <ToolbarItem Id="k-two" Text="Two" Enabled="false" />
        <ToolbarSeparator />
        <ToolbarItem Id="k-three" Text="Three" />
        <ToolbarItem Id="k-hidden" Text="Hidden" Visible="false" />
        <ToolbarSpacer />
        <ToolbarItem Id="k-four" Text="Four" />
        <ToolbarItem Id="k-toggle" Text="Toggle" Type="ToolbarItemType.Toggle" />
    </SfToolbar>
    <button id="after-toolbar" type="button">After</button>
    <p id="last-click">Last click: @_lastClick</p>

    <h2>Vertical</h2>
    <SfToolbar Id="toolbar-keys-v" Orientation="ToolbarOrientation.Vertical" AriaLabel="Vertical keyboard commands">
        <ToolbarItem Id="kv-one" Text="V One" />
        <ToolbarItem Id="kv-two" Text="V Two" />
        <ToolbarItem Id="kv-three" Text="V Three" />
    </SfToolbar>
</div>

@code {
    private bool _interactiveReady;
    private string _lastClick = "none";

    [SupplyParameterFromQuery(Name = "rtl")]
    public bool Rtl { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }
    }

    private void OnItemClick(ToolbarItemClickEventArgs args) => _lastClick = args.ItemId;
}
