@* ===================================================================
   STYLES
   =================================================================== *@
<style>
    /* ---------- Theme tokens (Microsoft Learn / Fluent 2 inspired) ---------- */
    .sf-doc-page {
        --sf-bg: #FFFFFF;
        --sf-bg-subtle: #FAFBFC;
        --sf-surface: #FFFFFF;
        --sf-surface-2: #F6F8FB;
        --sf-border: #E5E7EB;
        --sf-border-strong: #D1D5DB;
        --sf-text: #111827;
        --sf-text-2: #4B5563;
        --sf-text-3: #6B7280;
        --sf-text-muted: #9CA3AF;
        --sf-link: #2B357C;
        --sf-link-hover: #3B4693;
        --sf-purple: #2B357C;
        --sf-purple-50: #ECEEF7;
        --sf-purple-100: #D6DBED;
        --sf-purple-200: #A8B0D5;
        --sf-purple-700: #3B4693;
        --sf-success-bg: #ECFDF3;
        --sf-success-border: #ABEFC6;
        --sf-success-text: #067647;
        --sf-tip-bg: #EEF4FF;
        --sf-tip-border: #C7D7FE;
        --sf-tip-text: #1E40AF;
        --sf-code-bg: #0B1020;
        --sf-shadow-sm: 0 1px 2px rgba(15,23,42,.04);
        --sf-shadow-md: 0 2px 6px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
        --sf-shadow-lg: 0 10px 24px -8px rgba(15,23,42,.10), 0 4px 8px -2px rgba(15,23,42,.04);
        --sf-radius-sm: 6px;
        --sf-radius-md: 10px;
        --sf-radius-lg: 14px;
        --sf-radius-xl: 18px;
    }

    .dark .sf-doc-page {
        --sf-bg: #0B1020;
        --sf-bg-subtle: #0F172A;
        --sf-surface: #111827;
        --sf-surface-2: #0F172A;
        --sf-border: #1F2937;
        --sf-border-strong: #374151;
        --sf-text: #F1F5F9;
        --sf-text-2: #CBD5E1;
        --sf-text-3: #94A3B8;
        --sf-text-muted: #64748B;
        --sf-link: #A4ABE0;
        --sf-link-hover: #C4CCEC;
        --sf-purple: #8A93C4;
        --sf-purple-50: rgba(43, 53, 124, 0.20);
        --sf-purple-100: rgba(43, 53, 124, 0.30);
        --sf-purple-200: rgba(43, 53, 124, 0.30);
        --sf-purple-700: #A4ABE0;
        --sf-success-bg: rgba(16, 185, 129, 0.10);
        --sf-success-border: rgba(16, 185, 129, 0.30);
        --sf-success-text: #6EE7B7;
        --sf-tip-bg: rgba(59, 130, 246, 0.10);
        --sf-tip-border: rgba(59, 130, 246, 0.30);
        --sf-tip-text: #93C5FD;
        --sf-code-bg: #0A0E1C;
        --sf-shadow-sm: 0 1px 2px rgba(0,0,0,.4);
        --sf-shadow-md: 0 2px 6px rgba(0,0,0,.4), 0 1px 2px rgba(0,0,0,.3);
        --sf-shadow-lg: 0 10px 24px -8px rgba(0,0,0,.5), 0 4px 8px -2px rgba(0,0,0,.3);
    }

    /* ---------- Page container ---------- */
    .sf-doc-page {
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
        color: var(--sf-text);
        background: var(--sf-bg);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    .sf-doc-page * { box-sizing: border-box; }

    .sf-doc-page p { margin: 0 0 16px 0; color: var(--sf-text-2); }
    .sf-doc-page a { color: var(--sf-link); text-decoration: none; transition: color .15s ease; }
    .sf-doc-page a:hover { color: var(--sf-link-hover); text-decoration: underline; }
    .sf-doc-page code:not(pre code) {
        background: var(--sf-purple-50);
        color: var(--sf-purple-700);
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: 500;
    }
    .dark .sf-doc-page code:not(pre code) { color: #C4CCEC; }
    .sf-doc-page kbd {
        display: inline-block;
        background: var(--sf-surface-2);
        border: 1px solid var(--sf-border);
        border-bottom-width: 2px;
        border-radius: 4px;
        padding: 1px 6px;
        font-size: 12px;
        color: var(--sf-text-2);
    }

    /* The site-wide breadcrumb CSS lives in MainLayout.razor so it
       applies to every page, not just GettingStarted. */

    /* ---------- Hero ---------- */
    .sf-hero {
        background: linear-gradient(180deg, var(--sf-bg) 0%, var(--sf-bg-subtle) 100%);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-xl);
        padding: 0px 20px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }
    .sf-hero::before {
        content: "";
        position: absolute; top: -120px; right: -80px;
        width: 380px; height: 380px;
        background: radial-gradient(circle, var(--sf-purple-100) 0%, transparent 70%);
        pointer-events: none;
    }
    .sf-hero-content {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 260px;
        gap: 32px; align-items: center;
    }
    .sf-hero h1 {
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", system-ui, sans-serif;
        font-size: 42px; line-height: 1.15; font-weight: 600;
        letter-spacing: -0.02em; margin: 0 0 16px 0; color: var(--sf-text);
    }
    .sf-hero-subtitle {
        font-size: 16px; line-height: 1.6; color: var(--sf-text-2);
        max-width: 640px; margin: 0 0 24px 0;
    }
    .sf-hero-badges { display: flex; flex-wrap: wrap; gap: 8px; }
    .sf-badge {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 999px;
        font-size: 13px; font-weight: 600;
        border: 1px solid var(--sf-border);
        background: var(--sf-surface); color: var(--sf-text-2);
    }
    .sf-badge svg { color: var(--sf-text-3); }
    .sf-badge-time svg { color: #D97706; }
    .sf-badge-level svg { color: #2563EB; }
    .sf-badge-stack svg { color: var(--sf-purple); }

    /* Hero illustration */
    .sf-hero-illustration { position: relative; width: 100%; height: 220px; }
    .sf-illust-glow {
        position: absolute; inset: 10% 0;
        background: radial-gradient(circle, var(--sf-purple-100) 0%, transparent 65%);
        filter: blur(2px);
    }
    .sf-illust-card {
        position: absolute;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-md);
        box-shadow: var(--sf-shadow-lg);
        overflow: hidden;
    }
    .sf-illust-card-1 { top: 10px; left: 0; width: 160px; height: 110px; transform: rotate(-6deg); }
    .sf-illust-card-2 {
        bottom: 4px; right: 8px; width: 120px; height: 120px;
        transform: rotate(6deg);
        background: linear-gradient(135deg, var(--sf-purple) 0%, #5A63A8 100%);
        border-color: transparent;
    }
    .sf-illust-card-header {
        display: flex; gap: 4px; padding: 6px 8px;
        background: var(--sf-surface-2); border-bottom: 1px solid var(--sf-border);
    }
    .sf-illust-dot { width: 8px; height: 8px; border-radius: 50%; }
    .sf-illust-dot-r { background: #FCA5A5; }
    .sf-illust-dot-y { background: #FCD34D; }
    .sf-illust-dot-g { background: #86EFAC; }
    .sf-illust-card-body { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
    .sf-illust-row { height: 8px; border-radius: 4px; background: var(--sf-surface-2); }
    .sf-illust-row-head { background: var(--sf-purple-200); height: 10px; width: 60%; }
    .sf-illust-row:nth-child(2) { width: 90%; }
    .sf-illust-row:nth-child(3) { width: 75%; }
    .sf-illust-row:nth-child(4) { width: 85%; }
    .sf-illust-pie { padding: 0; height: 100%; position: relative; }
    .sf-illust-pie-ring {
        position: absolute; inset: 14px;
        border: 14px solid rgba(255,255,255,0.25);
        border-top-color: #FFFFFF; border-radius: 50%;
    }
    .sf-illust-pie-core {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 22px; height: 22px;
        border-radius: 50%; background: #FFFFFF;
    }
    .sf-illust-icon {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        width: 64px; height: 64px;
        border-radius: 16px; background: var(--sf-surface);
        color: var(--sf-purple);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 12px 30px -6px rgba(43, 53, 124, 0.45);
        border: 1px solid rgba(255,255,255,0.6);
    }
    .sf-illust-icon svg { display: block; }

    /* ---------- Host model picker ----------
       A 2-column row of SfRadioButton options (string-typed group).
       Each option is rendered as a card: border + surface + radius.
       The card is the label that wraps the radio, so clicking anywhere
       in the card toggles the radio (the native label + input
       association). The selected option shows a navy fill, a coloured
       border, and a strong glow to make the active choice obvious. */
    .sf-host-bar {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin: 0 0 32px 0;
    }
    .sf-host-option {
        display: flex; flex-direction: column; gap: 4px;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        padding: 14px 18px;
        cursor: pointer;
        transition: border-color .18s ease, box-shadow .18s ease, background .18s ease, transform .18s ease;
    }
    .sf-host-option:hover {
        border-color: var(--sf-purple-200);
        box-shadow: 0 4px 12px -4px rgba(43, 53, 124, 0.12);
    }
    /* Active state: navy-tinted background, bold navy border, strong
       accent glow, and a small check-style accent strip on the left
       so the user can immediately see which option is selected. */
    .sf-host-option.is-active {
        position: relative;
        background: linear-gradient(180deg, var(--sf-purple-50) 0%, var(--sf-surface) 100%);
    }
    /* Left-edge accent strip — a thin navy rail that visually anchors
       the selected state. Hidden on the inactive options. */
    .sf-host-option.is-active::before {
        content: "";
        position: absolute;
        left: 0; top: 12px; bottom: 12px;
        width: 4px;
        border-radius: 0 3px 3px 0;
    }
    /* Tint the radio label so it picks up the card foreground colour
       and matches the rest of the design system typography. When the
       option is active, push the label colour to the navy primary. */
    .sf-host-option .e-radio-wrapper {
        font-size: 14.5px;
        font-weight: 600;
        color: var(--sf-text);
    }
    .sf-host-option .e-radio-wrapper .e-label {
        color: var(--sf-text);
    }
    .sf-host-sub {
        font-size: 12.5px;
        color: var(--sf-text-3);
        margin-top: 2px;
        /* Indent the subtitle so it lines up under the radio label
           text rather than the radio circle. */
        padding-left: 32px;
    }
    /* Active state colour overrides — declared *after* the base
       .sf-host-sub rule above so the cascade picks them up. */
    .sf-host-option.is-active .e-radio-wrapper,
    .sf-host-option.is-active .e-radio-wrapper .e-label {
        color: var(--sf-purple);
    }
    /* The subtitle should also reflect the active state so the
       whole card "lights up" together. */
    .sf-host-option.is-active .sf-host-sub {
        color: var(--sf-purple);
        opacity: 0.85;
    }

    /* ---------- Templates section ---------- */
    /* Featured/elevated card. The thin accent bar on the top edge
       + the elevated shadow + the subtle gradient background make
       it stand out from the regular doc-page sections. */
    .sf-templates {
        position: relative;
        background: linear-gradient(180deg, var(--sf-purple-50) 0%, var(--sf-surface) 60%);
        border: 1px solid var(--sf-purple-200);
        border-radius: var(--sf-radius-xl);
        padding: 32px;
        margin-bottom: 40px;
        box-shadow:
            0 1px 0 rgba(255, 255, 255, 0.6) inset,
            0 12px 28px -10px rgba(43, 53, 124, 0.18),
            0 4px 10px -4px rgba(43, 53, 124, 0.08);
        overflow: hidden;
    }
    /* Decorative glow in the top-right corner reinforces the
       "featured" feel without competing with the content. */
    .sf-templates::before {
        content: ""; position: absolute; top: 0; right: 0;
        width: 320px; height: 320px;
        background: radial-gradient(circle at top right, var(--sf-purple-100) 0%, transparent 65%);
        pointer-events: none;
        opacity: .9;
    }
    .sf-templates-grid {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
        gap: 36px; align-items: center;
    }
    .sf-templates-left { padding-right: 12px; }
    .sf-templates-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        background: var(--sf-purple);
        color: #FFFFFF;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 24px; margin-bottom: 16px;
        box-shadow: 0 6px 14px -4px rgba(43, 53, 124, 0.45);
    }
    .sf-templates-left h2 {
        font-size: 32px; font-weight: 600; margin: 0 0 10px 0;
        color: var(--sf-text); letter-spacing: -0.015em; line-height: 1.25;
    }
    .sf-templates-left p {
        color: var(--sf-text-2); font-size: 16px; line-height: 1.6;
        margin: 0 0 22px 0; max-width: 480px;
    }
    .sf-templates-right {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;
    }
    .sf-template-mini {
        display: flex; flex-direction: column;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-md);
        padding: 10px; gap: 10px;
        text-decoration: none; color: inherit;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .sf-template-mini:hover {
        transform: translateY(-2px);
        box-shadow: var(--sf-shadow-md), 0 8px 20px -8px rgba(43, 53, 124, 0.20);
        border-color: var(--sf-purple);
        text-decoration: none;
    }
    .sf-template-mini-preview {
        height: 90px; border-radius: var(--sf-radius-sm);
        position: relative; overflow: hidden;
        background-size: cover; background-position: center;
    }
    .sf-template-mini-preview-1 { background: linear-gradient(135deg, #2B357C 0%, #5A63A8 50%, #A8B0D5 100%); }
    .sf-template-mini-preview-2 { background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 50%, #BFDBFE 100%); }
    .sf-template-mini-preview-3 { background: linear-gradient(135deg, #10B981 0%, #34D399 50%, #A7F3D0 100%); }
    .sf-template-mini-preview::after {
        content: ""; position: absolute; inset: 14px;
        background:
            linear-gradient(var(--sf-surface) 1px, transparent 1px) 0 0/100% 8px,
            linear-gradient(90deg, var(--sf-surface) 1px, transparent 1px) 0 0/8px 100%;
        background-blend-mode: lighten; opacity: 0.55; border-radius: 4px;
    }
    .sf-template-mini-chip {
        position: absolute; top: 8px; left: 8px; z-index: 1;
        background: rgba(255,255,255,0.92); color: #111827;
        font-size: 11px; font-weight: 600;
        padding: 2px 8px; border-radius: 999px;
    }
    .sf-template-mini-title { font-size: 13.5px; font-weight: 600; color: var(--sf-text); }
    .sf-template-mini-sub { font-size: 12px; color: var(--sf-text-3); margin-top: 2px; }

    /* ---------- Buttons ---------- */
    .sf-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        padding: 10px 18px; border-radius: 8px;
        font-size: 14.5px; font-weight: 600; line-height: 1;
        border: 1px solid transparent; cursor: pointer;
        text-decoration: none;
        transition: background .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease, transform .05s ease;
        font-family: inherit;
    }
    .sf-btn:hover { text-decoration: none; }
    .sf-btn:active { transform: translateY(1px); }
    .sf-btn-primary {
        background: var(--sf-purple); color: #FFFFFF;
        box-shadow: 0 1px 0 rgba(255,255,255,0.1) inset, 0 6px 14px -4px rgba(43, 53, 124, 0.45);
    }
    .sf-btn-primary:hover {
        background: var(--sf-purple-700); color: #FFFFFF;
        box-shadow: 0 1px 0 rgba(255,255,255,0.1) inset, 0 8px 18px -4px rgba(43, 53, 124, 0.55);
    }
    .sf-btn-preview {
        padding: 8px 16px; font-size: 14px; border-radius: 6px;
        cursor: default; box-shadow: var(--sf-shadow-sm);
    }
    .sf-btn-default { background: #FFFFFF; color: #1F2937; border-color: #D1D5DB; }
    .sf-btn-success { background: #10B981; color: #FFFFFF; border-color: #10B981; }
    .sf-btn-info    { background: #3B82F6; color: #FFFFFF; border-color: #3B82F6; }
    .sf-btn-warning { background: #F59E0B; color: #FFFFFF; border-color: #F59E0B; }
    .sf-btn-danger  { background: #EF4444; color: #FFFFFF; border-color: #EF4444; }
    .dark .sf-btn-default { background: #1F2937; color: #F1F5F9; border-color: #374151; }

    /* ---------- Section ---------- */
    .sf-section { margin: 0 0 48px 0; scroll-margin-top: 96px; }
    .sf-step-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .sf-step-num {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 50%;
        background: var(--sf-purple); color: #FFFFFF;
        font-weight: 700; font-size: 14px; flex-shrink: 0;
        box-shadow: 0 4px 10px -2px rgba(43, 53, 124, 0.45);
    }
    .sf-section h2 {
        font-size: 32px; font-weight: 600; margin: 0;
        color: var(--sf-text); letter-spacing: -0.015em; line-height: 1.25;
    }
    .sf-section-lede {
        font-size: 16px; color: var(--sf-text-2); line-height: 1.65;
        margin: 0 0 22px 0; max-width: 760px;
    }

    /* ---------- Prereq list ---------- */
    .sf-prereq-list {
        list-style: none; padding: 0; margin: 0;
        display: grid; gap: 10px;
    }
    .sf-prereq-list li {
        display: flex; gap: 12px; align-items: center;
        padding: 14px 16px;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-md);
    }
    .sf-prereq-icon {
        width: 32px; height: 32px;
        border-radius: 50%;
        background: var(--sf-success-bg);
        color: var(--sf-success-text);
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .sf-prereq-title { font-weight: 600; color: var(--sf-text); font-size: 14.5px; }
    .sf-prereq-sub { font-size: 13.5px; color: var(--sf-text-3); margin-top: 2px; }
    .sf-prereq-sub a { color: var(--sf-link); }

    /* ---------- Tabs Card ---------- */
    .sf-tabs-card {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        overflow: hidden; box-shadow: var(--sf-shadow-sm);
        margin-bottom: 18px;
    }
    .sf-tabs-bar {
        display: flex;
        background: var(--sf-surface-2);
        border-bottom: 1px solid var(--sf-border);
        padding: 0 8px; gap: 2px;
        overflow-x: auto; scrollbar-width: none;
    }
    .sf-tabs-bar::-webkit-scrollbar { display: none; }
    .sf-tab,
    .sf-tabs-bar > .sf-tab,
    .sf-tabs-bar .e-btn.sf-tab {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 18px;
        background: transparent !important;
        border: 0;
        border-bottom: 4px solid transparent;
        color: var(--sf-text-3);
        font-size: 13.5px; font-weight: 600; font-family: inherit;
        cursor: pointer; white-space: nowrap;
        transition: color .15s ease, border-color .15s ease, background .15s ease;
        margin-bottom: -1px;
        border-radius: 0;
        box-shadow: none;
        min-height: 0;
        line-height: 1.2;
    }
    .sf-tab:hover { color: var(--sf-text); }
    .sf-tab.is-active,
    .sf-tabs-bar > .sf-tab.is-active,
    .sf-tabs-bar .e-btn.sf-tab.is-active {
        color: var(--sf-purple);
        border-bottom-color: var(--sf-purple);
        background: var(--sf-surface) !important;
    }
    .sf-tab svg { color: currentColor; }
    .sf-tab.is-active svg { color: var(--sf-purple); }

    /* ---------- Code Card ---------- */
    .sf-code-card {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        overflow: hidden; box-shadow: var(--sf-shadow-sm);
        margin-bottom: 18px;
    }

    /* ---------- VS callout (Create Project -> Visual Studio tab) ----------
       A clean, prose-style block that sits inside the tabs card
       instead of a monospaced code block. The card chrome (border +
       surface + padding) is provided by the parent .sf-tabs-card. */
    .sf-vs-callout {
        background: var(--sf-surface);
        padding: 20px 24px;
        font-size: 15px;
        line-height: 1.65;
        color: var(--sf-text-2);
    }
    .sf-vs-callout p {
        margin: 0;
        color: var(--sf-text-2);
    }
    .sf-vs-callout strong {
        color: var(--sf-text);
        font-weight: 600;
    }

    /* ---------- Tip / Info banner ---------- */
    .sf-tip {
        display: flex; gap: 12px;
        background: var(--sf-tip-bg);
        border: 1px solid var(--sf-tip-border);
        border-left: 3px solid var(--sf-tip-text);
        border-radius: var(--sf-radius-md);
        padding: 14px 16px; color: var(--sf-tip-text);
    }
    .sf-tip-icon { display: inline-flex; flex-shrink: 0; padding-top: 2px; }
    .sf-tip-title {
        font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--sf-tip-text); margin-bottom: 2px;
    }
    .sf-tip-body { font-size: 14.5px; line-height: 1.55; color: var(--sf-text); }
    .sf-tip-body code { color: var(--sf-tip-text); }

    /* ---------- Success banner ---------- */
    .sf-banner { display: flex; gap: 12px; padding: 14px 16px; border-radius: var(--sf-radius-md); align-items: flex-start; }
    .sf-banner-success {
        background: var(--sf-success-bg);
        border: 1px solid var(--sf-success-border);
        border-left: 3px solid var(--sf-success-text);
        color: var(--sf-success-text);
    }
    .sf-banner-icon { display: inline-flex; flex-shrink: 0; padding-top: 1px; }
    .sf-banner-title { font-weight: 600; font-size: 14.5px; }
    .sf-banner-sub { font-size: 13.5px; color: var(--sf-text-2); margin-top: 2px; }
    .sf-banner-sub code { background: rgba(0,0,0,0.04); color: var(--sf-text); }
    .dark .sf-banner-sub code { background: rgba(255,255,255,0.08); color: var(--sf-text); }

    /* ---------- Preview Card ---------- */
    .sf-preview-card {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        overflow: hidden; box-shadow: var(--sf-shadow-sm);
        margin-top: 8px;
    }
    .sf-preview-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 16px;
        background: var(--sf-surface-2);
        border-bottom: 1px solid var(--sf-border);
    }
    .sf-preview-label {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--sf-text-3);
    }
    .sf-preview-meta {
        font-size: 12.5px; color: var(--sf-text-3);
        font-family: "Cascadia Code", "JetBrains Mono", Consolas, monospace;
    }
    .sf-preview-body {
        display: flex; flex-wrap: wrap; gap: 10px;
        padding: 24px; background: var(--sf-surface);
        align-items: center; justify-content: center;
    }
    /* SfButtonGroup inside the preview body should keep the
       outline/colour demo buttons on a single line but still
       wrap gracefully on small screens. */
    .sf-preview-body .sf-btn-group-preview {
        flex-wrap: wrap;
        row-gap: 8px;
    }

    /* ---------- Run list ---------- */
    .sf-run-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
    .sf-run-list li {
        display: grid; grid-template-columns: 180px 1fr; gap: 16px; align-items: start;
        padding: 14px 16px;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-md);
    }
    .sf-run-ide { font-weight: 700; color: var(--sf-text); font-size: 14px; }
    .sf-run-desc { color: var(--sf-text-2); font-size: 14.5px; line-height: 1.55; }

    /* ---------- Next steps ---------- */
    .sf-next-steps { margin: 16px 0 40px 0; scroll-margin-top: 96px; }
    .sf-next-steps h2 {
        font-size: 32px; font-weight: 600; letter-spacing: -0.015em;
        margin: 0 0 18px 0; color: var(--sf-text); line-height: 1.25;
    }
    .sf-next-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .sf-next-card {
        display: flex; align-items: center; gap: 12px;
        padding: 16px;
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        text-decoration: none; color: inherit;
        transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    }
    .sf-next-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--sf-shadow-md);
        border-color: var(--sf-purple-200);
        text-decoration: none;
    }
    .sf-next-icon {
        width: 40px; height: 40px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .sf-next-icon-purple { background: var(--sf-purple-50); color: var(--sf-purple); }
    .sf-next-icon-blue   { background: #DBEAFE; color: #2563EB; }
    .sf-next-icon-pink   { background: #FCE7F3; color: #DB2777; }
    .sf-next-title { font-weight: 600; font-size: 14.5px; color: var(--sf-text); }
    .sf-next-desc  { font-size: 13px; color: var(--sf-text-3); margin-top: 2px; }
    .sf-next-arrow { color: var(--sf-text-muted); flex-shrink: 0; }
    .sf-next-card:hover .sf-next-arrow { color: var(--sf-purple); }

    /* ---------- Responsive ---------- */
    @@media (max-width: 960px) {
        .sf-hero-content { grid-template-columns: 1fr; }
        .sf-hero-illustration { display: none; }
        .sf-templates-grid { grid-template-columns: 1fr; }
        .sf-templates-right { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .sf-next-grid { grid-template-columns: 1fr; }
        .sf-run-list li { grid-template-columns: 1fr; gap: 4px; }
        .sf-host-bar { grid-template-columns: 1fr; }
    }
    @@media (max-width: 640px) {
        .sf-hero { padding: 28px 22px; }
        .sf-hero h1 { font-size: 36px; }
        .sf-section h2, .sf-next-steps h2 { font-size: 26px; }
        .sf-templates-right { grid-template-columns: 1fr; }
