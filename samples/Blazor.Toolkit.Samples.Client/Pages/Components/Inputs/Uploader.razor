        new("multiple-files", "Multiple Files"),
        new("auto-upload", "Auto Upload"),
        new("validation", "Validation"),
        new("chunk-upload", "Chunk Upload"),
        new("template", "Template"),
        new("events", "Events"),
        new("drop-effect", "Drop Effect"),
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
