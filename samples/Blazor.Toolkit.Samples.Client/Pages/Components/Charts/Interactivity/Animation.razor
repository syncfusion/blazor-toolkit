@page "/charts/interactivity/animation"
@inherits TocPublishingComponentBase
@using Blazor.Toolkit.Samples.Client.Pages.Demos.Charts.Interactivity.Animation

<PageTitle>Blazor Chart Animation Demo | Syncfusion Toolkit</PageTitle>
<Description>
    <Header>
        <h1 id="animation">Animation</h1>
    </Header>
    <Content>
        <p>
            Animation enhances the Chart by smoothly rendering data during load or updates. To enable animation, set the <code>Enable</code> property in <code>ChartSeriesAnimation</code> to <code>true</code>. You can customize the animation's timing using the <code>Duration</code> and <code>Delay</code> properties. Selection allows users to focus on specific data points or series, while Highlight emphasizes data elements on hover. Together, these features improve interactivity, readability, and overall data exploration experience.
        </p>
    </Content>
</Description>
<CodePreview IsFullWidth="true" PreviewComponent="typeof(AnimationDemo)" SourceFile="Pages/Demos/Charts/Interactivity/Animation/AnimationDemo.razor" />

@code {
    private static readonly IReadOnlyList<RightToc.TocItem> TocItemsList = new[]
    {
        new RightToc.TocItem("animation", "Animation", 4)
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
