    {
        new RightToc.TocItem("overview", "Overview", 4),
        new RightToc.TocItem("data-label", "Data Label", 4),
        new RightToc.TocItem("stacking-bar", "Stacking Bar", 4),
        new RightToc.TocItem("stacking-labels", "Stacking Labels", 4),
        new RightToc.TocItem("stacking-group", "Stacking Group", 4),
        new RightToc.TocItem("100-stacking-bar", "100% Stacking Bar", 4),
        new RightToc.TocItem("grouped-bar", "Grouped Bar", 4),
        new RightToc.TocItem("negative-data", "Negative Data", 4),
        new RightToc.TocItem("bar-with-track", "Bar With Track", 4),
        new RightToc.TocItem("customizing-bar-spacing-and-width", "Customizing Bar Spacing and Width", 4),
        new RightToc.TocItem("bar-width-in-pixels", "Bar Width in Pixels", 4),
        new RightToc.TocItem("series-customization", "Series Customization", 4),
        new RightToc.TocItem("customizing-data-point-colors", "Customizing Data Point Colors", 4)
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
