        new RightToc.TocItem("stacking-group", "Stacking Group", 4),
        new RightToc.TocItem("100-stacking-column", "100% Stacking Column", 4),
        new RightToc.TocItem("column-placement", "Column Placement", 4),
        new RightToc.TocItem("negative-data", "Negative Data", 4),
        new RightToc.TocItem("column-drilldown", "Column Drilldown", 4),
        new RightToc.TocItem("grouping-column", "Grouping Column", 4),
        new RightToc.TocItem("column-with-track", "Column With Track", 4),
        new RightToc.TocItem("customizing-column-spacing-and-width", "Customizing Column Spacing And Width", 4),
