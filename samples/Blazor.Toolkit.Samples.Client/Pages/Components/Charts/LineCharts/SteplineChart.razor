        new RightToc.TocItem("skip-missing-points", "Skip Missing Points", 4),
        new RightToc.TocItem("inverted-axes", "Inverted Axes", 4),
        new RightToc.TocItem("step-position", "Step Position", 4),
        new RightToc.TocItem("series-customization", "Series Customization", 4)
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
