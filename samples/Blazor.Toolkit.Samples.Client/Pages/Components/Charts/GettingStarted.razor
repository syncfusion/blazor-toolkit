@page "/charts/getting-started"
@inherits TocPublishingComponentBase

@using Syncfusion.Blazor.Toolkit.Charts
@using Blazor.Toolkit.Samples.Client.Pages.Demos.Charts.GettingStarted

<PageTitle>Blazor Chart Quick Start | Syncfusion Toolkit</PageTitle>

<Description>
    <Header>
        <h1>Getting Started with Chart</h1>
    </Header>
    <Content>
        The Syncfusion Blazor Chart component is a powerful, lightweight solution for visualizing data with interactive and responsive charts. This guide provides a quick setup and minimal usage example to get you creating charts quickly.
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="prerequisites">Prerequisites</h2>
    </Header>
    <Content>
        <ul>
            <li>.NET 9.0 or later</li>
            <li>Blazor Server or WebAssembly project</li>
            <li>Developer tooling such as Visual Studio or Visual Studio Code</li>
        </ul>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="install">Install</h2>
    </Header>
    <Content>
        <p>Install the NuGet package into your Blazor project:</p>
        <CodePreview FileName="terminal" IsCodeAlone="true" CodeSection="dotnet add package Syncfusion.Blazor.Toolkit"></CodePreview>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="register-services-program-cs">Register Services (Program.cs)</h2>
    </Header>
    <Content>
        <p>Add the toolkit services to your application's startup. Example for a Server-hosted app:</p>
        <CodePreview FileName="Program.cs" IsCodeAlone="true" CodeSection="@ProgramCode"></CodePreview>
        <p>For WebAssembly projects, register the corresponding interactive/webassembly services in the client project's Program.cs.</p>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="include-assets">Include Assets</h2>
    </Header>
    <Content>
        <p>Include the Syncfusion theme CSS in your layout file (App.razor or index.html). Add the following link in the <code>&lt;head&gt;</code> section:</p>
        <CodePreview FileName="HTML" IsCodeAlone="true" CodeSection="@CssAssets"></CodePreview>
        <p>Choose a theme that suits your application. Available themes include <code>bootstrap5</code>, <code>fluent</code>, <code>material</code>, and more.</p>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="basic-chart-example">Basic Chart Example</h2>
    </Header>
    <Content>
        <p>Create a basic Column Chart with sample data:</p>
        <CodePreview FileName="Chart.razor" IsCodeAlone="true" CodeSection="@BasicChartExample"></CodePreview>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="adding-chart-title">Adding Chart Title</h2>
    </Header>
    <Content>
        <p>Display a meaningful title to provide context about the data:</p>
        <CodePreview FileName="Chart.razor" IsCodeAlone="true" CodeSection="@ChartTitleExample"></CodePreview>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="adding-data-labels">Adding Data Labels</h2>
    </Header>
    <Content>
        <p>Enable data labels to display values on each data point:</p>
        <CodePreview FileName="Chart.razor" IsCodeAlone="true" CodeSection="@DataLabelExample"></CodePreview>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="adding-tooltip">Adding Tooltip</h2>
    </Header>
    <Content>
        <p>Enable tooltips to show data point information on hover:</p>
        <CodePreview FileName="Chart.razor" IsCodeAlone="true" CodeSection="@TooltipExample"></CodePreview>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="complete-chart-example">Complete Chart Example</h2>
    </Header>
    <Content>
        <p>Here's a complete, fully-featured Chart combining all the features:</p>
        <VirtualizeSection MinHeightPx="600px">
            <CodePreview IsFullWidth="true" PreviewComponent="typeof(CompleteChartExampleDemo)" SourceFile="Pages/Demos/Charts/GettingStarted/CompleteChartExampleDemo.razor" />
        </VirtualizeSection>
    </Content>
</Description>

@code {
    private static readonly IReadOnlyList<RightToc.TocItem> TocItemsList = new[]
    {
        new RightToc.TocItem("prerequisites", "Prerequisites", 4),
        new RightToc.TocItem("install", "Install", 4),
        new RightToc.TocItem("register-services-program-cs", "Register Services (Program.cs)", 4),
        new RightToc.TocItem("include-assets", "Include Assets", 4),
        new RightToc.TocItem("basic-chart-example", "Basic Chart Example", 4),
        new RightToc.TocItem("adding-chart-title", "Adding Chart Title", 4),
        new RightToc.TocItem("adding-data-labels", "Adding Data Labels", 4),
        new RightToc.TocItem("adding-tooltip", "Adding Tooltip", 4),
        new RightToc.TocItem("complete-chart-example", "Complete Chart Example", 4)
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;

    private string ProgramCode = @"@using Syncfusion.Blazor.Toolkit;

var builder = WebApplication.CreateBuilder(args);
builder.Services.AddRazorComponents().AddInteractiveServerComponents();

// Register Syncfusion Toolkit services
builder.Services.AddSyncfusionBlazorToolkit();
var app = builder.Build();";

    private string CssAssets = @"<link id=""syncfusion-theme"" href=""_content/Syncfusion.Blazor.Toolkit/styles/fluent.min.css"" rel=""stylesheet"" />";

    private string BasicChartExample = @"@using Syncfusion.Blazor.Toolkit.Charts

<SfChart>

    <ChartSeries DataSource=""@Sales"" XName=""Month"" YName=""SalesValue"" Type=""ChartSeriesType.Column"">
    </ChartSeries>

</SfChart>

@code {
    public class SalesInfo
    {
        public string Month { get; set; }
        public double SalesValue { get; set; }
    }

    public List<SalesInfo> Sales = new List<SalesInfo>
    {
        new SalesInfo { Month = ""Jan"", SalesValue = 35 },
        new SalesInfo { Month = ""Feb"", SalesValue = 28 },
        new SalesInfo { Month = ""Mar"", SalesValue = 34 },
        new SalesInfo { Month = ""Apr"", SalesValue = 32 },
        new SalesInfo { Month = ""May"", SalesValue = 40 },
        new SalesInfo { Month = ""Jun"", SalesValue = 32 },
        new SalesInfo { Month = ""Jul"", SalesValue = 35 }
    };
}";

    private string ChartTitleExample = @"@using Syncfusion.Blazor.Toolkit.Charts

<SfChart Title=""Sales Analysis"">
    <ChartPrimaryXAxis Title=""Month"" ValueType=""Syncfusion.Blazor.Toolkit.ValueType.Category""></ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title=""Sales in Dollar""></ChartPrimaryYAxis>

    <ChartSeries DataSource=""@Sales"" XName=""Month"" YName=""SalesValue"" Type=""ChartSeriesType.Column"">
    </ChartSeries>

</SfChart>";

    private string DataLabelExample = @"@using Syncfusion.Blazor.Toolkit.Charts

<SfChart Title=""Sales Analysis"">
    <ChartPrimaryXAxis Title=""Month"" ValueType=""Syncfusion.Blazor.Toolkit.ValueType.Category""></ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title=""Sales in Dollar""></ChartPrimaryYAxis>

    <ChartSeries DataSource=""@Sales"" XName=""Month"" YName=""SalesValue"" Type=""ChartSeriesType.Column"">
        <ChartMarker>
            <ChartDataLabel Visible=""true""></ChartDataLabel>
        </ChartMarker>
    </ChartSeries>

</SfChart>";

    private string TooltipExample = @"@using Syncfusion.Blazor.Toolkit.Charts

<SfChart Title=""Sales Analysis"">
    <ChartPrimaryXAxis Title=""Month"" ValueType=""Syncfusion.Blazor.Toolkit.ValueType.Category""></ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title=""Sales in Dollar""></ChartPrimaryYAxis>
    <ChartTooltipSettings Enable=""true""></ChartTooltipSettings>

    <ChartSeries DataSource=""@Sales"" XName=""Month"" YName=""SalesValue"" Type=""ChartSeriesType.Column"">
    </ChartSeries>

</SfChart>";
}
