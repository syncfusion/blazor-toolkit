@page "/layout/card"
@inherits TocPublishingComponentBase
@using Blazor.Toolkit.Samples.Client.Pages.Demos.Layout.Card

<PageTitle>Blazor Card Demo | Syncfusion Toolkit</PageTitle>

<Description>
    <Header>
        <h1 id="blazor-toolkit-card-component">Blazor Toolkit Card Component</h1>
    </Header>
    <Content>
        The Card is a composition surface. Place header, title, subtitle, media, content, actions, footer, and separator blocks inside <code>SfCard</code>. It is not a data-bound list.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(DefaultDemo)" SourceFile="/Pages/Demos/Layout/Card/DefaultDemo.razor" />

<Description>
    <Header>
        <h2 id="positions">Positions</h2>
    </Header>
    <Content>
        The card renders its regions in the order you add them. Place <code>SfCardMedia</code> before or after the header to control media position.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(PositionsDemo)" SourceFile="/Pages/Demos/Layout/Card/PositionsDemo.razor" />

<Description>
    <Header>
        <h2 id="media">Media</h2>
    </Header>
    <Content>
        <code>SfCardMedia</code> renders an image or custom content. Set <code>Alt</code> when the image conveys information. Leave it empty when the image is decorative.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(MediaDemo)" SourceFile="/Pages/Demos/Layout/Card/MediaDemo.razor" />

<Description>
    <Header>
        <h2 id="actions">Actions</h2>
    </Header>
    <Content>
        Put buttons in <code>SfCardActions</code>. Nested controls keep their own tab stop and do not activate a clickable card. Use <code>IsLoading</code> to show a busy state during the action.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(ActionsDemo)" SourceFile="/Pages/Demos/Layout/Card/ActionsDemo.razor" />

<Description>
    <Header>
        <h2 id="expandable">Expandable</h2>
    </Header>
    <Content>
        Use controlled content (or <code>IsClickable</code> with an <code>AriaLabel</code>) to create an expandable card that reveals additional media and details on demand.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(ExpandableDemo)" SourceFile="/Pages/Demos/Layout/Card/ExpandableDemo.razor" />

<Description>
    <Header>
        <h2 id="loading">Loading</h2>
    </Header>
    <Content>
        <code>IsLoading</code> marks the card busy, dims the surface, blocks activation, and makes actions unreachable until loading ends.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(LoadingDemo)" SourceFile="/Pages/Demos/Layout/Card/LoadingDemo.razor" />

<Description>
    <Header>
        <h2 id="orientation">Orientation</h2>
    </Header>
    <Content>
        <code>Orientation</code> is Vertical by default. Horizontal places the media beside the content and flips in right-to-left layouts. Use the checkboxes to show or hide regions without changing orientation.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(HorizontalDemo)" SourceFile="/Pages/Demos/Layout/Card/HorizontalDemo.razor" />

<Description>
    <Header>
        <h2 id="analytics">Analytics Card</h2>
    </Header>
    <Content>
        A professional analytics card that hosts a simple Chart. Ideal for KPI widgets, sales overviews, and dashboard summaries.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(AnalyticsCardDemo)" SourceFile="/Pages/Demos/Layout/Card/AnalyticsCardDemo.razor" />

@code {
    private static readonly IReadOnlyList<RightToc.TocItem> TocItemsList = new RightToc.TocItem[]
    {
        new("positions", "Positions"),
        new("media", "Media"),
        new("actions", "Actions"),
        new("expandable", "Expandable"),
        new("loading", "Loading"),
        new("orientation", "Orientation"),
        new("analytics", "Analytics Card"),
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}

<style>
.card-demo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-start;
}

.card-demo-row-equal {
    display: flex;
    align-items: stretch;
}

.card-demo-row-equal > .e-card {
    height: auto;
    align-self: stretch;
}

.card-demo-center {
    display: flex;
    justify-content: center;
}

.card-demo-spotlight {
    max-width: 100%;
}

.card-demo-horizontal {
    max-width: 560px;
}

.card-demo-horizontal-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}

.card-demo-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 12px;
}

.card-demo-stats {
    display: flex;
    gap: 24px;
    margin: 0 16px 8px;
    padding-top: 12px;
    border-top: 1px solid var(--color-sf-border, rgba(0, 0, 0, 0.08));
}

.card-demo-stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.card-demo-stats span:first-child {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
}

.card-demo-stats span:last-child {
    font-size: 1.05rem;
    font-weight: 600;
}

.card-demo-status {
    margin: 0;
    min-height: 1.4em;
}

.card-demo-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 240ms ease;
}

.card-demo-panel-open {
    grid-template-rows: 1fr;
}

.card-demo-panel-inner {
    overflow: hidden;
    min-height: 0;
}

.card-demo-panel-inner > .e-card-media {
    margin: 4px 16px 0;
    border-radius: 8px;
    overflow: hidden;
}

.card-demo-chevron {
    margin-inline-start: auto;
    color: inherit;
    font: inherit;
    line-height: 1;
    padding: 4px 8px;
}

.card-demo-header-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
}

.card-demo-header-row .e-card-header {
    flex: 1;
    min-width: 0;
}

.card-demo-kpi {
    max-width: 100%;
}

.card-demo-kpi-body {
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    align-items: center;
    width: 100%;
}

.card-demo-kpi-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
}

.card-demo-kpi-change {
    margin-top: 4px;
    font-weight: 600;
    color: var(--color-sf-success-text, var(--color-sf-success, #15803d));
}

.card-demo-kpi-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 8px;
    font-size: 0.85rem;
    opacity: 0.8;
}

.card-demo-chart {
    min-width: 0;
    padding: 8px 16px 8px 8px;
}

.card-demo-kpi .e-card-header {
    padding-bottom: 8px;
}

@@media (max-width: 640px) {
    .card-demo-kpi-body {
        grid-template-columns: 1fr;
    }
}
</style>
