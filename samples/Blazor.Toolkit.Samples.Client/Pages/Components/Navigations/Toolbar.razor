@page "/navigations/toolbar"
@inherits TocPublishingComponentBase
@using Blazor.Toolkit.Samples.Client.Pages.Demos.Navigations.Toolbar

<PageTitle>Blazor Toolbar Demo | Syncfusion Toolkit</PageTitle>

<div class="toolbar-demo-page">
<Description>
    <Header>
        <h1 id="blazor-toolkit-toolbar-component">Blazor Toolkit Toolbar Component</h1>
    </Header>
    <Content>
        Use <code>SfToolbar</code> to show document commands. This sample uses <code>ToolbarItem</code>, <code>ToolbarGroup</code>, <code>ToolbarSeparator</code>, and <code>ToolbarSpacer</code>. Icon-only commands use <code>IconCss</code> and <code>DisplayMode</code>. These items use <code>ToolbarItemType.Button</code> for actions. Use <code>ToolbarItemType.Toggle</code> with a <code>Selected</code> binding to maintain selection for stateful items.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(DefaultDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/DefaultDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="overflow">Overflow & Priority</h2>
    </Header>
    <Content>
        Choose an <code>OverflowMode</code> and change the available width to see how the items move or wrap. In Popup mode, <code>Overflow</code> and <code>Priority</code> decide which items stay on the toolbar and which move to the menu.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(OverflowDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/OverflowDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="items">Item Types</h2>
    </Header>
    <Content>
        Set <code>ToolbarItem.Type</code> to <code>Toggle</code>, <code>Check</code>, <code>Split</code>, <code>DropDown</code>, or <code>Menu</code> to add different commands. <code>Selected</code> keeps a command active, <code>GroupName</code> groups alignment choices, and <code>Items</code> adds menu choices.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(ItemsDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/ItemsDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="templates">Templates</h2>
    </Header>
    <Content>
        Use <code>ToolbarItemType.Template</code> and <code>Template</code> to add a search box, item count, and List/Grid controls. The toolbar also sorts the files and uses Refresh to restore the starting list.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(TemplatesDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/TemplatesDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="editor">Editor</h2>
    </Header>
    <Content>
        <code>SfToolbar.Items</code> creates the editor commands. <code>OnItemClick</code> handles them and updates the text. Try the font and size menus, formatting buttons, alignment buttons, and Reset.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(EditorDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/EditorDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="orientation">Orientation</h2>
    </Header>
    <Content>
        Set <code>Orientation</code> to <code>ToolbarOrientation.Horizontal</code> or <code>ToolbarOrientation.Vertical</code> to change the toolbar layout. Use the <code>SfButtonGroup</code> to switch between the two layouts.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(OrientationDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/OrientationDemo.razor" IsFullWidth="true" />

<Description>
    <Header>
        <h2 id="style">Toolbar Style</h2>
    </Header>
    <Content>
        Set <code>CssClass</code> on each toolbar to give it a different style. The sample changes background, hover, selected, text, and icon colors, including in dark mode.
    </Content>
</Description>

<CodePreview PreviewComponent="typeof(ColorDemo)" SourceFile="/Pages/Demos/Navigations/Toolbar/ColorDemo.razor" IsFullWidth="true" />

</div>

@code {
    private static readonly IReadOnlyList<RightToc.TocItem> TocItemsList = new RightToc.TocItem[]
    {
        new("overflow", "Overflow & Priority"),
        new("items", "Item Types"),
        new("templates", "Templates"),
        new("editor", "Editor"),
        new("orientation", "Orientation"),
        new("style", "Toolbar Style"),
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
