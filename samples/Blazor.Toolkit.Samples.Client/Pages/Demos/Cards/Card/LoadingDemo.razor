<div class="card-demo-row">
    <SfCard IsLoading="@_loading" IsClickable="true" AriaLabel="Loading product" Variant="CardVariant.Outlined" Width="280px">
        <SfCardHeader>
            <SfCardTitle>Trail Runner</SfCardTitle>
        </SfCardHeader>
        <SfCardContent>Product details are loading.</SfCardContent>
        <SfCardActions>
            <SfButton Content="Buy" IsPrimary="true" />
        </SfCardActions>
    </SfCard>
    <SfButton Content="@(_loading ? "Stop loading" : "Start loading")" OnClick="Toggle" />
</div>

@code {
    private bool _loading = true;

    private void Toggle() => _loading = !_loading;
}
