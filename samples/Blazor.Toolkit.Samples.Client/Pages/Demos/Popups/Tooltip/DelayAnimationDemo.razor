        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
    }

        .demo-section h6 {
            margin: 0 0 8px 0;
            color: #333;
            font-size: 14px;
        }

    .demo-hint {
        margin: 0 0 16px 0;
        color: #666;
        font-size: 13px;
        font-style: italic;
    }

    .delay-animation-demo .button-group {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        justify-content: center;
    }
</style>