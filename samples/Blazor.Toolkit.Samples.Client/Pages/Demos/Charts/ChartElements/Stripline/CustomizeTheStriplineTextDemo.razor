
<SfChart @key="@_currentTheme" Title="Wind Speed and Gust (km/h)" Theme="@_currentTheme">

    <!-- X Axis (DateTime) -->
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.DateTime" LabelFormat="ddd dd/MM" LabelRotation="-90">
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisMajorGridLines Width="0" />
    </ChartPrimaryXAxis>

    <!-- Y Axis -->
    <ChartPrimaryYAxis Title="Wind Speed and Gust (km/h)"
                       Minimum="0"
                       Maximum="30"
                       Interval="5"
                       RangePadding="ChartRangePadding.None">
        <ChartAxisLineStyle Width="0"/>
        <ChartAxisMajorTickLines Width="0"/>
        <ChartStriplines>
            <ChartStripline Start="0" End="5"
                            Text="Calm"
                            HorizontalAlignment="Anchor.Start"
                            VerticalAlignment="Anchor.Middle"
                            Color="rgba(68,170,213,0.1)"  />

            <ChartStripline Start="5" End="8"
                            Text="Light Air"
                            HorizontalAlignment="Anchor.Middle"
                            VerticalAlignment="Anchor.Start"
                            Color="rgba(0,0,0,0)" />

            <ChartStripline Start="8" End="11"
                            Text="Light Breeze"
                            HorizontalAlignment="Anchor.End"
                            VerticalAlignment="Anchor.Middle"
                            Color="rgba(68,170,213,0.1)" />

            <ChartStripline Start="11" End="18"
                            Text="Gentle Breeze"
                            HorizontalAlignment="Anchor.Middle"
                            VerticalAlignment="Anchor.End"
                            Color="rgba(0,0,0,0)" />

            <ChartStripline Start="18" End="28"
                            Text="Moderate Breeze"
                            HorizontalAlignment="Anchor.End"
                            VerticalAlignment="Anchor.Start"
                            Color="rgba(68,170,213,0.1)" />

            <ChartStripline Start="28" End="30"
                            Text="Fresh Breeze"
                            HorizontalAlignment="Anchor.Start"
                            VerticalAlignment="Anchor.End"
                            Color="rgba(0,0,0,0)" />
        </ChartStriplines>
    </ChartPrimaryYAxis>

    <!-- Series -->


    <ChartSeries DataSource="@WindSpeedData"
                 XName="Date"
                 YName="Wind"
                 Name="Wind Speed (km/h)"
                 Type="ChartSeriesType.Spline"
                 Width="2"
                 Fill="#01A725"
                 LegendShape="LegendShape.HorizontalLine" />

    <ChartSeries DataSource="@WindGustData"
                 XName="Date"
                 YName="Gust"
                 Name="Wind Gust (km/h)"
                 Type="ChartSeriesType.Spline"
                 Width="2"
                 Fill="#FF8225"
                 LegendShape="LegendShape.HorizontalLine" />


    <!-- Tooltip -->
    <ChartTooltipSettings Enable="true" EnableHighlight="true"
                          EnableMarker="true"
                          ShowNearestTooltip="true"
                          Format="${point.x}<br/>${series.name}: <b>${point.y}</b>" />

    <!-- Legend -->
    <ChartLegendSettings Visible="true"
                         ShapeHeight="6"
                         ShapeWidth="15" />

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class WindGustInfo
    {
        public DateTime Date { get; set; }
        public double Gust { get; set; }
    }

    public class WindSpeedInfo
    {
        public DateTime Date { get; set; }
        public double Wind { get; set; }
