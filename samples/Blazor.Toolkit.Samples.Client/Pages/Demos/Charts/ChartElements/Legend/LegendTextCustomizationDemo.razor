
<SfChart @key="@_currentTheme" Title="Life Expectancy for People of Different Ages, France" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />

    <ChartPrimaryYAxis Minimum="25"
                       Maximum="90"
                       Format="{value} Years">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>


    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="AtBirth" Name="At Birth" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#0A97B0"></ChartSeries>
    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="Age10" Name="10 Year old" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#FF8225"></ChartSeries>
    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="Age25" Name="25 Year old" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#006A71"></ChartSeries>
    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="Age45" Name="45 Year old" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#AC1754"></ChartSeries>
    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="Age65" Name="65 Year old" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#37AFE1"></ChartSeries>
    <ChartSeries DataSource="@FranceBirthData" XName="Year" YName="Age80" Name="80 Year old" Type="ChartSeriesType.Line" LegendShape="LegendShape.SeriesType" Fill="#6A9C89"></ChartSeries>


    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="${series.name} : <b>${point.y}</b>" />

    <ChartLegendSettings Visible="true"
                         MaximumLabelWidth="130">
        <ChartLegendTextStyle Size="20px"
                               FontWeight="bold"
                               Color="#1993c4ff" />
    </ChartLegendSettings>

</SfChart>

