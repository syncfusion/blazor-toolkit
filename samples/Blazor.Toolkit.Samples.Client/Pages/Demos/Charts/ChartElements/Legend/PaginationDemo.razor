
<SfChart @key="@_currentTheme" Title="Renewable Sources Used to Generate Electricity for Transport Fuels" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />

    <ChartPrimaryYAxis>
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>


    <ChartSeries DataSource="@PagingData" XName="Year" YName="OnshoreWind" Name="Onshore wind" Width="2" Type="ChartSeriesType.Spline" Fill="#FF9874">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="OffshoreWind" Name="Offshore wind" Width="2" Type="ChartSeriesType.Spline" Fill="#D2649A">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="MarineEnergy" Name="Marine energy" Width="2" Type="ChartSeriesType.Spline" Fill="#7D8ABC">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="SolarPV" Name="Solar photovoltaics" Width="2" Type="ChartSeriesType.Spline" Fill="#7695FF">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="SmallScaleHydro" Name="Small scale Hydro" Width="2" Type="ChartSeriesType.Spline" Fill="#898AC4">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="LargeScaleHydro" Name="Large scale Hydro" Width="2" Type="ChartSeriesType.Spline" Fill="#B3C890">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="PlantBiomass" Name="Plant biomass" Width="2" Type="ChartSeriesType.Spline" Fill="#CD8D7A">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="AnimalBiomass" Name="Animal biomass" Width="2" Type="ChartSeriesType.Spline" Fill="#D7B26D">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="LandfillGas" Name="Landfill gas" Width="2" Type="ChartSeriesType.Spline" Fill="#286944ff">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>
    <ChartSeries DataSource="@PagingData" XName="Year" YName="SewageGas" Name="Sewage gas" Width="2" Type="ChartSeriesType.Spline" Fill="#6A9C89">
        <ChartSeriesAnimation Enable="false" />
        <ChartMarker Visible="true" />
    </ChartSeries>


    <ChartTooltipSettings Enable="true" Header="${point.x}" Format="${series.name}: <b>${point.y}</b>" />

    <ChartLegendSettings Visible="true" Width="315" Height="50" />

</SfChart>

@code {
