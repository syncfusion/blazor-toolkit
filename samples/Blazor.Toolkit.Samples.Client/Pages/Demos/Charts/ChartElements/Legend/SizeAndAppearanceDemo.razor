
<SfChart @key="@_currentTheme" Title="Annual Percentage Change in Fossil Fuel Consumption" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category">
        <ChartPrimaryXAxis LabelRotation="-45" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Interval="10"
                       Format="{value}%">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>


    <ChartSeries DataSource="@ChinaSizeData"
                 XName="Year"
                 YName="Value"
                 Name="China"
                 Type="ChartSeriesType.Line"
                 Fill="#898AC4">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@GermanySizeData"
                 XName="Year"
                 YName="Value"
                 Name="Germany"
                 Type="ChartSeriesType.Line"
                 Fill="#B3C890">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@SpainSizeData"
                 XName="Year"
                 YName="Value"
                 Name="Spain"
                 Type="ChartSeriesType.Line"
                 Fill="#CD8D7A">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@UKSizeData"
                 XName="Year"
                 YName="Value"
                 Name="U.K"
                 Type="ChartSeriesType.Line"
                 Fill="#D7B26D">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@USASizeData"
                 XName="Year"
                 YName="Value"
                 Name="USA"
                 Type="ChartSeriesType.Line"
                 Fill="#6A9C89">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>


    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="${series.name} : <b>${point.y}</b>" />

    <ChartLegendSettings Visible="true"
                         Background="#e6a112">
        <ChartLegendBorder Width="2" Color="#865b01" />
    </ChartLegendSettings>

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

