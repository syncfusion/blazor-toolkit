
<SfChart @key="@_currentTheme" Title="Annual Change in Hydropower Generation" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category">
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Interval="200"
                       Format="{value}TWh">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>


    <ChartSeries DataSource="@ChinaLegendAlignData"
                 XName="Year"
                 YName="Value"
                 Name="China"
                 Type="ChartSeriesType.Line"
                 LegendShape="LegendShape.Circle"
                 Fill="#5DB996">
        <ChartMarker Visible="true" Height="7" Width="7" />
    </ChartSeries>

    <ChartSeries DataSource="@FranceLegendAlignData"
                 XName="Year"
                 YName="Value"
                 Name="France"
                 Type="ChartSeriesType.Line"
                 LegendShape="LegendShape.Circle"
                 Fill="#FF748B">
        <ChartMarker Visible="true" Height="7" Width="7" />
    </ChartSeries>

    <ChartSeries DataSource="@GermanyLegendAlignData"
                 XName="Year"
                 YName="Value"
                 Name="Germany"
                 Type="ChartSeriesType.Line"
                 LegendShape="LegendShape.Circle"
                 Fill="#60B5FF">
        <ChartMarker Visible="true" Height="7" Width="7" />
    </ChartSeries>


    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="${series.name} : <b>${point.y}</b>" />

    <ChartLegendSettings Visible="true"
                         Alignment="Alignment.Far">
    </ChartLegendSettings>

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

