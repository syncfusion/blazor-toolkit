
<div class="legend-controls" style="@LegendControlsStyle">
    <div style="display: flex; align-items: center; gap: 10px;">
        <label style="font-weight: 500;">Shape Height:</label>
        <input type="range" min="10" max="50" @bind="shapeHeight" @bind:event="oninput" style="cursor: pointer;" />
        <span style="min-width: 25px">@shapeHeight</span>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
        <label style="font-weight: 500;">Shape Width:</label>
        <input type="range" min="10" max="50" @bind="shapeWidth" @bind:event="oninput" style="cursor: pointer;" />
        <span style="min-width: 25px">@shapeWidth</span>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
        <label style="font-weight: 500;">Shape Padding:</label>
        <input type="range" min="0" max="50" @bind="shapePadding" @bind:event="oninput" style="cursor: pointer;" />
        <span style="min-width: 25px">@shapePadding</span>
    </div>
</div>
 <SfChart @key="@_currentTheme" Title="Renewable Sources Used to Generate Electricity for Transport Fuels" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />

    <ChartPrimaryYAxis>
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>


    <ChartSeries DataSource="@PagingData"
                 XName="Year"
                 YName="LargeScaleHydro"
                 Name="Large scale Hydro"
                 Type="ChartSeriesType.Line"
                 Fill="#6A9C89">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@PagingData"
                 XName="Year"
                 YName="AnimalBiomass"
                 Name="Animal biomass"
                 Type="ChartSeriesType.Line"
                 Fill="#D7B26D">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@PagingData"
                 XName="Year"
                 YName="LandfillGas"
                 Name="Landfill gas"
                 Type="ChartSeriesType.Line"
                 Fill="#B3C890">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>

    <ChartSeries DataSource="@PagingData"
                 XName="Year"
                 YName="SewageGas"
                 Name="Sewage gas"
                 Type="ChartSeriesType.Line"
                 Fill="#7695FF">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" />
    </ChartSeries>


    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="${series.name} : <b>${point.y}</b>" />

    <ChartLegendSettings Visible="true"
                         ShapeHeight="@shapeHeight"
                         ShapeWidth="@shapeWidth"
                         ShapePadding="@shapePadding">
    </ChartLegendSettings>

</SfChart>

@code {
