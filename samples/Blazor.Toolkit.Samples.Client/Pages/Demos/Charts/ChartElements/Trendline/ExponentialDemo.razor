
<SfChart @key="@_currentTheme" Title="Global Internet Users Growth (1995-2023)"
         SubTitle="Source: International Telecommunication Union (ITU)" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category"
                       Title="Year">
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Minimum="0"
                       Maximum="6000"
                       Interval="1000"
                       Title="Users (Millions)">
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>

    <ChartTooltipSettings Enable="true"
                          Shared="true"
                          ShowNearestTooltip="true"
                          Format="Internet Users: <b>${point.y}M</b>">
    </ChartTooltipSettings>

    <ChartLegendSettings Visible="true"
                         ShapeHeight="15"
                         ShapeWidth="15">
    </ChartLegendSettings>


    <ChartSeries DataSource="@TrendlineExponentialData"
                 XName="Year"
                 YName="Users"
                 Name="Internet Users"
                 Type="ChartSeriesType.Spline"
                 Width="2.5"
                 Fill="#1976D2">

        <ChartSeriesAnimation Enable="false"></ChartSeriesAnimation>

        <ChartMarker Visible="true"
                     Width="7"
                     Height="7"
                     Shape="ChartShape.Circle">
        </ChartMarker>

        <ChartTrendlines>
            <ChartTrendline Type="TrendlineTypes.Exponential"
                            Name="Exponential Trend"
                            Width="3"
                            DashArray="5,5"
                            Fill="#D32F2F"
                            EnableTooltip="false">
                <ChartTrendlineAnimation Enable="false"></ChartTrendlineAnimation>
            </ChartTrendline>
        </ChartTrendlines>

    </ChartSeries>

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class InternetUserPoint
    {
        public string Year { get; set; }
        public double Users { get; set; }
    }

