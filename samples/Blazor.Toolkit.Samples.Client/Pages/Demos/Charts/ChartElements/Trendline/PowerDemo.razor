
<SfChart @key="@_currentTheme" Title="Solar Panel Cost Decline (1980-2022)"
         SubTitle="Source: Our World in Data" Theme="@_currentTheme">

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category"
                       Title="Year">
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Minimum="0"
                       Maximum="100"
                       Interval="20"
                       Title="Cost per Watt (USD)">
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>

    <ChartTooltipSettings Enable="true"
                          Shared="true"
                          ShowNearestTooltip="true"
                          Format="Cost per Watt: <b>$${point.y}</b>" />

    <ChartLegendSettings Visible="true"
                         ShapeHeight="15"
                         ShapeWidth="15" />


    <ChartSeries DataSource="@TrendlinePowerData"
                 XName="Year"
                 YName="Value"
                 Name="Solar Cost"
                 Type="ChartSeriesType.Scatter"
                 Fill="#FF9800">

        <ChartSeriesAnimation Enable="false" />

        <ChartMarker Visible="true"
                     Width="10"
                     Height="10"
                     Shape="ChartShape.Circle"
                     Fill="#FF9800">
        </ChartMarker>

        <ChartTrendlines>
            <ChartTrendline Type="TrendlineTypes.Power"
                            Name="Power Law Trend"
                            Width="2"
                            Fill="#1565C0"
                            EnableTooltip="false">
                <ChartTrendlineAnimation Enable="false" />
            </ChartTrendline>
        </ChartTrendlines>

    </ChartSeries>

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class PowerTrendPoint
    {
        public string Year { get; set; }
        public double Value { get; set; }
    }

    public List<PowerTrendPoint> TrendlinePowerData = new()
    {
        new() { Year = "1980", Value = 38.5 },
        new() { Year = "1985", Value = 12.8 },
        new() { Year = "1990", Value = 8.5 },
        new() { Year = "1995", Value = 5.2 },
        new() { Year = "2000", Value = 4.8 },
        new() { Year = "2005", Value = 3.6 },
        new() { Year = "2010", Value = 1.8 },
        new() { Year = "2015", Value = 0.65 },
        new() { Year = "2020", Value = 0.28 },
        new() { Year = "2022", Value = 0.26 }
    };
}
