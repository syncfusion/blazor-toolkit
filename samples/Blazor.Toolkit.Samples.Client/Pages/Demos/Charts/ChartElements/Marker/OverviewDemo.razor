        new MarkerOverviewInfo { Year = 2008, China = -20.3, UnitedStates = -19.0 },
        new MarkerOverviewInfo { Year = 2009, China = -18.3, UnitedStates = -19.9 },
        new MarkerOverviewInfo { Year = 2010, China = -19.0, UnitedStates = -18.5 },
        new MarkerOverviewInfo { Year = 2011, China = -21.1, UnitedStates = -19.9 },
