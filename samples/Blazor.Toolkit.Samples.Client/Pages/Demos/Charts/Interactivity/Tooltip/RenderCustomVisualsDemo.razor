<SfChart @key="@_currentTheme" Theme="@_currentTheme" Background="Transparent" Title="Top 5 Countries by Population in 2025">
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />
    <ChartPrimaryYAxis LabelFormat="{value}M"
                       Title="Population (Millions)" />
    <ChartTooltipSettings Enable="true">
        <Template>
            @{
                var data = context as ChartTooltipInfo;
                CountryMap.TryGetValue(data?.X?.ToString() ?? string.Empty, out var country);

                if (country != null)
                {
                    <div style="
                    width:260px;
                    padding:12px;
                    border-radius:12px;
                    background:linear-gradient(135deg,#ff9ad5,#e8ddff);
                    box-shadow:0 4px 8px rgba(0,0,0,0.2);">

                        <div style="font-size:18px;font-weight:bold;margin-bottom:8px;">
                            @country.Country
                        </div>

                        <table style="width:100%;font-size:14px;">
                            <tr>
                                <td>
                                    <b>Capital</b>
                                </td>
                                <td>: @country.Capital</td>
                            </tr>
                            <tr>
                                <td>
                                    <b>Population</b>
                                </td>
                                <td>: @country.Population.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td>
                                    <b>Area</b>
                                </td>
                                <td>: @country.Area</td>
                            </tr>
                        </table>
                    </div>
                }
            }
        </Template>
    </ChartTooltipSettings>

    <ChartSeries DataSource="@Countries"
                 XName="Country"
                 YName="Population"
                 Type="ChartSeriesType.Column">
    </ChartSeries>
</SfChart>
<style>
    .custom-tooltip {
        background: linear-gradient(135deg, #ff80cf, #e6d8ff);
        color: #000;
        padding: 12px;
        border-radius: 12px;
        width: 260px;
    }

    .tooltip-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        margin-bottom: 8px;
    }

    .tooltip-body p {
        margin: 2px 0;
        font-size: 14px;
    }
</style>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
