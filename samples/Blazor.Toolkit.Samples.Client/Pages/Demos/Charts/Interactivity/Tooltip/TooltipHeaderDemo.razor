<SfChart @key="@_currentTheme" Theme="@_currentTheme" Background="Transparent" Title="Household Consumption Expenditure Per Capita">
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.DateTime"
                       Interval="5">
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis LineStyle="new ChartAxisLineStyle { Width = 0 }"
                       Maximum="15">
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@tooltipHeaderData"
                 XName="X"
                 YName="UnitedStates"
                 Type="ChartSeriesType.Spline"
                 Name="United States"
                 Fill="#99CC00">
    </ChartSeries>

    <ChartSeries DataSource="@tooltipHeaderData"
                 XName="X"
                 YName="Italy"
                 Type="ChartSeriesType.Spline"
                 Name="Italy"
                 Fill="#66CCFF">
    </ChartSeries>

    <ChartTooltipSettings Enable="true"
                          ShowHeaderLine="true"
                          Format="${point.x} : <b>${point.y}%</b>">
    </ChartTooltipSettings>
</SfChart>

