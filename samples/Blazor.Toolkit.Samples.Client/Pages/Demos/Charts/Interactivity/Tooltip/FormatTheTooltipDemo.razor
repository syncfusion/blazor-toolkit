<SfChart @key="@_currentTheme" Theme="@_currentTheme" Background="Transparent" Title="U.S. Agricultural Trade">
    <ChartArea Border="@(new ChartAreaBorder { Width = 0 })" />

    <ChartTooltipSettings Enable="true"
                          EnableMarker="false"
                          Format="Trade Type : <b>${series.name}</b><br/>
                      Calendar Year : <b>${point.x}</b><br/>
                      Amount : <b>$${point.y}</b>">
    </ChartTooltipSettings>

    <ChartPrimaryXAxis Minimum="1990" Maximum="2020" />
    <ChartPrimaryYAxis Title="USD" Format="{value}B" Minimum="0" Maximum="180" Interval="30" />

    <ChartSeries DataSource="@ExportData"
                 XName="X"
                 YName="Y"
                 Type="ChartSeriesType.Line"
                 Width="3"
                 Fill="#FF8225"
                 Name="Exports">
    </ChartSeries>

    <ChartSeries DataSource="@ImportData"
                 XName="X"
                 YName="Y"
                 Type="ChartSeriesType.Line"
                 Width="3"
                 Fill="#0A97B080"
                 Name="Imports">
    </ChartSeries>
</SfChart>

