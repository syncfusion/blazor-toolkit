<SfChart @key="@_currentTheme" Title="Payment Shares by Mode (2015-2024)" Width="100%" Height="400px" Theme="@_currentTheme">

    <ChartTooltipSettings Enable="true"
                          Format="<b>${series.name}</b><br />Year: <b>${point.x}</b><br />Share: <b>${point.y}%</b>" />

    <ChartLegendSettings Visible="true" Position="LegendPosition.Bottom" />

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.DateTime"
                       RangePadding="ChartRangePadding.Normal"
                       LabelFormat="yyyy">
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Minimum="0"
                       Maximum="100"
                       Interval="20"
                       LabelFormat="{value}%">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@BankTransfer"
                 XName="X"
                 YName="Y"
                 Name="Bank-Transfer"
                 Type="ChartSeriesType.StackingArea100"
                 Fill="#B1212D"
                 Opacity="1"
                 Border="@(new ChartSeriesBorder { Width = 0.5, Color = "#ffffff" })"
                 LegendShape="LegendShape.Circle" />

    <ChartSeries DataSource="@CreditCard"
                 XName="X"
                 YName="Y"
                 Name="Credit Card"
                 Type="ChartSeriesType.StackingArea100"
                 Fill="#E77A16"
                 Opacity="1"
                 Border="@(new ChartSeriesBorder { Width = 0.5, Color = "#ffffff" })"
                 LegendShape="LegendShape.Circle" />

    <ChartSeries DataSource="@DebitCard"
                 XName="X"
                 YName="Y"
                 Name="Debit Card"
                 Type="ChartSeriesType.StackingArea100"
                 Fill="#6200EE"
                 Opacity="1"
                 Border="@(new ChartSeriesBorder { Width = 0.5, Color = "#ffffff" })"
                 LegendShape="LegendShape.Circle" />

    <ChartSeries DataSource="@Cash"
                 XName="X"
                 YName="Y"
                 Name="Cash"
                 Type="ChartSeriesType.StackingArea100"
                 Fill="#05B3DA"
                 Opacity="1"
                 Border="@(new ChartSeriesBorder { Width = 0.5, Color = "#ffffff" })"
                 LegendShape="LegendShape.Circle" />
</SfChart>

