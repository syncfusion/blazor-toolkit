        new() { X = "Mar", Y = 23.1 },
        new() { X = "Apr", Y = 27.9 },
        new() { X = "May", Y = 32.2 },
        new() { X = "Jun", Y = 36.4 },
        new() { X = "Jul", Y = 39.8 },
        new() { X = "Aug", Y = 38.4 },
