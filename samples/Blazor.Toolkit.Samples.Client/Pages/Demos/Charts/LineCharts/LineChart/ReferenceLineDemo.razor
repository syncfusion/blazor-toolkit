<SfChart @key="@_currentTheme" Title="Weekly sales vs Target" Theme="@_currentTheme">
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.DateTime"
                       Minimum="new DateTime(2024, 3, 27)"
                       Maximum="new DateTime(2024, 6, 26)" Format="MMM dd, yyyy" LabelRotation="-45">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Title="Sales" Minimum="0" RangePadding="ChartRangePadding.None" LabelFormat="{value}K">
        <ChartAxisLineStyle Width="0" />

        <ChartStriplines>
            <ChartStripline Start="12" End="12.1"
                            DashArray="10,10"
                            Color="#79747E"
                            ZIndex="ZIndexPosition.Over"
                            Visible="true" />

            <ChartStripline Start="12.5" End="12.6"
                            Text="Weekly sales target"
                            Color="Transparent"
                            Visible="true"
                            HorizontalAlignment="Anchor.Start">
                <ChartStriplineTextStyle Size="14px" FontWeight="400" Color="@TextColor" />
            </ChartStripline>
        </ChartStriplines>
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@WeeklySalesData"
                 XName="Date"
                 YName="Sales"
                 Type="ChartSeriesType.Line">
        <ChartMarker Visible="true">
            <ChartDataLabel Visible="true" Format="${value}"
                            Font="@(new ChartDataLabelFont { Color = TextColor })">
                <ChartDataLabelBorder Width="2" Color="#0A97B0" />
            </ChartDataLabel>
        </ChartMarker>
    </ChartSeries>

    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="Sales : <b>${point.y}</b>"
                          EnableHighlight="true" />
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    private bool IsDarkTheme => _currentTheme.ToString().Contains("Dark") || _currentTheme.ToString().Contains("HighContrast");
    private string TextColor => IsDarkTheme ? "#FFFFFF" : "#000000";

    public class WeeklySalesPoint
    {
        public DateTime Date { get; set; }
        public double Sales { get; set; }
    }

    public List<WeeklySalesPoint> WeeklySalesData = new()
    {
        new() { Date = new DateTime(2024, 3, 27), Sales = 7 },
        new() { Date = new DateTime(2024, 4, 3),  Sales = 11 },
        new() { Date = new DateTime(2024, 4, 10), Sales = 4.5 },
        new() { Date = new DateTime(2024, 4, 17), Sales = 8.5 },
        new() { Date = new DateTime(2024, 4, 24), Sales = 6 },
        new() { Date = new DateTime(2024, 5, 1),  Sales = 13 },
        new() { Date = new DateTime(2024, 5, 8),  Sales = 13.2 },
        new() { Date = new DateTime(2024, 5, 15), Sales = 11.5 },
        new() { Date = new DateTime(2024, 5, 22), Sales = 5.5 },
        new() { Date = new DateTime(2024, 5, 29), Sales = 9.8 },
        new() { Date = new DateTime(2024, 6, 5),  Sales = 8 },
        new() { Date = new DateTime(2024, 6, 12), Sales = 14.8 },
        new() { Date = new DateTime(2024, 6, 19), Sales = 7.2 },
        new() { Date = new DateTime(2024, 6, 26), Sales = 15.2 }
    };
}
