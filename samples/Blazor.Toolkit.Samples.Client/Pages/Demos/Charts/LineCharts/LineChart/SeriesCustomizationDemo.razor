<SfChart @key="@_currentTheme" Title="GDP Growth rate (1960 - 2020)" Theme="@_currentTheme">
    <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Double">
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisMinorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Minimum="-10" Maximum="15" Interval="5">
        <ChartAxisLineStyle Width="0" />
        <ChartAxisMajorTickLines Width="0" />
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@IndiaGDPData"
                 XName="Year"
                 YName="Value"
                 Name="India"
                 Width="3"
                 Type="ChartSeriesType.Line" />

    <ChartSeries DataSource="@JapanGDPData"
                 XName="Year"
                 YName="Value"
                 Name="Japan"
                 Width="1"
                 Type="ChartSeriesType.Line" />

    <ChartSeries DataSource="@USAGDPData"
                 XName="Year"
                 YName="Value"
                 Name="USA"
                 Width="1"
                 Type="ChartSeriesType.Line" />

    <ChartLegendSettings EnableHighlight="true" />
    <ChartTooltipSettings Enable="true"
                          Shared="true"
                          Header="<b>${point.x}</b>"
                          Format="${series.name} : <b>${point.y}%</b>"
                          EnableHighlight="true" />
</SfChart>

