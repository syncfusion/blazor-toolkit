<SfChart @key="@_currentTheme" Title="Annual Gold Price (2009-2023) in USD" Theme="@_currentTheme">
    <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Double">
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisMinorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Title="% Annual Exchange Rate">
        <ChartAxisLineStyle Width="0" />
        <ChartAxisMajorTickLines Width="0" />

        <ChartStriplines>
            <ChartStripline Start="20" End="20.5"
                            DashArray="10,10"
                            Color="#79747E"
                            Visible="true" />
            <ChartStripline Start="21" End="21.5"
                            Text="Highest Annual Growth"
                            Color="Transparent"
                            Visible="true"
                            HorizontalAlignment="Anchor.End">
                <ChartStriplineTextStyle Color="@HighestTextColor" FontWeight="500" />
            </ChartStripline>

            <ChartStripline Start="-25" End="-24.5"
                            DashArray="10,10"
                            Color="#79747E"
                            Visible="true" />
            <ChartStripline Start="-28.5" End="-28"
                            Text="Lowest Annual Growth"
                            Color="Transparent"
                            Visible="true"
                            HorizontalAlignment="Anchor.End">
                <ChartStriplineTextStyle Color="@LowestTextColor" FontWeight="500" />
            </ChartStripline>
        </ChartStriplines>
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@GoldGrowthData"
                 XName="X"
                 YName="USD"
                 Type="ChartSeriesType.Line"
                 Fill="@SeriesColor">
        <ChartMarker Visible="true" IsFilled="true" />
    </ChartSeries>

    <ChartTooltipSettings Enable="true"
                          Header="<b>${point.x}</b>"
                          Format="Annual Growth : <b>${point.y}</b>"
                          EnableHighlight="true" />
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    private bool IsDarkTheme => _currentTheme.ToString().Contains("Dark") || _currentTheme.ToString().Contains("HighContrast");
    private string SeriesColor => IsDarkTheme ? "#77E4D4" : "#0A97B0";
    private string HighestTextColor => IsDarkTheme ? "#50C812" : "#337D0E";
    private string LowestTextColor => IsDarkTheme ? "#F5463C" : "#E02F25";

    public class GoldGrowthPoint
    {
        public int X { get; set; }
        public double USD { get; set; }
    }

    public List<GoldGrowthPoint> GoldGrowthData = new()
    {
        new() { X = 2009, USD = 23.4 },
        new() { X = 2010, USD = 29.5 },
        new() { X = 2011, USD = 10.1 },
        new() { X = 2012, USD = 7.0 },
        new() { X = 2013, USD = -28.3 },
        new() { X = 2014, USD = -1.5 },
        new() { X = 2015, USD = -10.4 },
        new() { X = 2016, USD = 9.1 },
        new() { X = 2017, USD = 13.6 },
        new() { X = 2018, USD = -2.1 },
        new() { X = 2019, USD = 18.9 },
        new() { X = 2020, USD = 24.6 },
        new() { X = 2021, USD = -3.5 },
        new() { X = 2022, USD = -0.3 },
        new() { X = 2023, USD = 12.8 }
    };
}
