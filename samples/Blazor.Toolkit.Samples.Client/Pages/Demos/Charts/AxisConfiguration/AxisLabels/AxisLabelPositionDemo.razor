@using Syncfusion.Blazor.Toolkit.Buttons

<div class="mb-4">
    <label class="fw-bold d-block mb-2">Label Position</label>

    <SfButtonGroup Mode="SelectionMode.Single">
        <Button Selected="@IsSelected(Syncfusion.Blazor.Toolkit.AxisPosition.Inside)"
                SelectedChanged="@(v => OnPositionChanged(v, Syncfusion.Blazor.Toolkit.AxisPosition.Inside))">
            Inside
        </Button>

        <Button Selected="@IsSelected(Syncfusion.Blazor.Toolkit.AxisPosition.Outside)"
                SelectedChanged="@(v => OnPositionChanged(v, Syncfusion.Blazor.Toolkit.AxisPosition.Outside))">
            Outside
        </Button>
    </SfButtonGroup>
</div>

<SfChart @key="@_currentTheme" Title="Population by Country 2024" Theme="@_currentTheme">
    <ChartArea>
        <ChartAreaBorder Width="0" />
    </ChartArea>

    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="Population : <b>${point.y}</b>"
                          EnableHighlight="true" />

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category"
                       LabelFormat="{value}B"
                       LabelPosition="@CurrentLabelPosition"
                       LabelIntersectAction="LabelIntersectAction.Rotate90">
        <ChartAxisLabelStyle Color="@LabelColor" />
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisMinorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis>
        <ChartAxisLineStyle Width="0" />
        <ChartAxisMajorTickLines Width="0" />
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@PopulationData"
                 XName="X"
                 YName="Y"
                 Type="ChartSeriesType.Column"
                 Fill="#43CDFF"
                 Width="0.5"
                 CornerRadius="@(new ChartCornerRadius { TopLeft = 5, TopRight = 5 })" />
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class PopulationPoint
    {
        public string X { get; set; } = string.Empty;
        public double Y { get; set; }
    }

    public List<PopulationPoint> PopulationData = new()
    {
        new() { X = "India",        Y = 1.42 },
        new() { X = "China",        Y = 1.41 },
        new() { X = "USA",          Y = 0.33 },
        new() { X = "Indonesia",    Y = 0.27 },
        new() { X = "Pakistan",     Y = 0.24 },
        new() { X = "Nigeria",      Y = 0.22 },
        new() { X = "Brazil",       Y = 0.21 },
        new() { X = "Bangladesh",   Y = 0.17 }
    };

    public Syncfusion.Blazor.Toolkit.AxisPosition CurrentLabelPosition { get; set; }
        = Syncfusion.Blazor.Toolkit.AxisPosition.Outside;

    public bool IsSelected(Syncfusion.Blazor.Toolkit.AxisPosition position) => CurrentLabelPosition == position;

    public void OnPositionChanged(bool selected, Syncfusion.Blazor.Toolkit.AxisPosition position)
    {
        if (selected)
        {
            CurrentLabelPosition = position;
        }
    }

    public string LabelColor =>
        CurrentLabelPosition == Syncfusion.Blazor.Toolkit.AxisPosition.Inside
            ? "black"
            : null;
}
