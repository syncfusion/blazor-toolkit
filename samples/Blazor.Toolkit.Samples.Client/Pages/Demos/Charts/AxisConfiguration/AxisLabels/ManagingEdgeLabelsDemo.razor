@using Syncfusion.Blazor.Toolkit.Buttons

<div class="mb-4">
    <label class="fw-bold d-block mb-2">Edge Label Placement</label>

    <SfButtonGroup Mode="SelectionMode.Single">
        <Button Selected="@IsSelected(EdgeLabelPlacement.Hide)"
                SelectedChanged="@(v => OnEdgePlacementChanged(v, EdgeLabelPlacement.Hide))">
            Hide
        </Button>

        <Button Selected="@IsSelected(EdgeLabelPlacement.None)"
                SelectedChanged="@(v => OnEdgePlacementChanged(v, EdgeLabelPlacement.None))">
            None
        </Button>

        <Button Selected="@IsSelected(EdgeLabelPlacement.Shift)"
                SelectedChanged="@(v => OnEdgePlacementChanged(v, EdgeLabelPlacement.Shift))">
            Shift
        </Button>
    </SfButtonGroup>
</div>

<SfChart @key="@_currentTheme" Title="Population by Country 2024" Theme="@_currentTheme">
    <ChartArea>
        <ChartAreaBorder Width="0" />
    </ChartArea>

    <ChartTooltipSettings Enable="true"
                          Header="${point.x}"
                          Format="Population : <b>${point.y}</b>"
                          EnableHighlight="true" />

    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category"
                       EdgeLabelPlacement="@CurrentEdgePlacement"
                       LabelPlacement="LabelPlacement.OnTicks">
        <ChartAxisMajorGridLines Width="0" />
        <ChartAxisMajorTickLines Width="0" />
        <ChartAxisMinorTickLines Width="0" />
    </ChartPrimaryXAxis>

    <ChartPrimaryYAxis Interval="0.3"
                       LabelFormat="{value}B">
        <ChartAxisLineStyle Width="0" />
        <ChartAxisMajorTickLines Width="0" />
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@PopulationData"
                 XName="X"
                 YName="Y"
                 Type="ChartSeriesType.Line"
                 Fill="@SeriesColor">
        <ChartMarker Visible="true" IsFilled="false" />
    </ChartSeries>
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    private bool IsDarkTheme => _currentTheme.ToString().Contains("Dark") || _currentTheme.ToString().Contains("HighContrast");
    private string SeriesColor => IsDarkTheme ? "#BA7DDA" : "#87CEEB";

    public class PopulationPoint
    {
        public string X { get; set; } = string.Empty;
        public double Y { get; set; }
    }

    public List<PopulationPoint> PopulationData = new()
    {
        new() { X = "India",        Y = 1.42 },
        new() { X = "China",        Y = 1.41 },
        new() { X = "USA",          Y = 0.33 },
        new() { X = "Indonesia",    Y = 0.27 },
        new() { X = "Pakistan",     Y = 0.24 },
        new() { X = "Nigeria",      Y = 0.22 },
        new() { X = "Brazil",       Y = 0.21 },
        new() { X = "Bangladesh",   Y = 0.17 }
    };

    public EdgeLabelPlacement CurrentEdgePlacement { get; set; } = EdgeLabelPlacement.Shift;

    public bool IsSelected(EdgeLabelPlacement placement) => CurrentEdgePlacement == placement;

    public void OnEdgePlacementChanged(bool selected, EdgeLabelPlacement placement)
    {
        if (selected)
        {
            CurrentEdgePlacement = placement;
        }
    }
}
