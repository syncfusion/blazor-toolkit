<SfChart @key="@_currentTheme" Title="Global Ocean Temperature Anomalies (1880-2022)" Theme="@_currentTheme">
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Double" Maximum="2022" Interval="20"></ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title="Temperature Anomaly (°C)" Minimum="-0.5" Maximum="0.8" Interval="0.2" Format="{value}°C"></ChartPrimaryYAxis>

    <ChartSeries DataSource="@rectSeriesNegativeData" XName="Year" YName="Anomaly" Type="ChartSeriesType.Column" PointColorMapping="Color">
        <ChartCornerRadius TopLeft="2" TopRight="2"></ChartCornerRadius>
    </ChartSeries>

    <ChartTooltipSettings Enable="true" Header="${point.x}" Format="Anomaly: <b>${point.y}</b>" />
</SfChart>

