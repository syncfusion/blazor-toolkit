<svg style="height:0">
    <defs>
        <linearGradient id="appleGradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8C3BC8" />
            <stop offset="100%" stop-color="#CE59FF" />
        </linearGradient>

        <linearGradient id="xiaomiGradient" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#45AF20" />
            <stop offset="100%" stop-color="#80C76D" />
        </linearGradient>

        <linearGradient id="oppoGradient" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="#8F94FB" />
            <stop offset="100%" stop-color="#4E54C8" />
        </linearGradient>
    </defs>
</svg>

<SfChart @key="@_currentTheme" Title="Global Smartphone Sales Trends by Brand (2021-2023)" Theme="@_currentTheme">
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />

    <ChartPrimaryYAxis Title="Units Sold (in Millions)" Maximum="300" Format="{value}M">
        <ChartAxisLineStyle Width="0" />
    </ChartPrimaryYAxis>

    <ChartTooltipSettings Enable="true"
                          Header="${series.name}"
                          Format="${point.x} : <b>${point.y}M</b>" />

    <ChartSeries DataSource="@salesReport"
                 XName="Year"
                 YName="AppleSales"
                 Type="ChartSeriesType.Bar"
                 Fill="url(#appleGradient)"
                 Opacity="0.8"
                 Name="Apple"
                 ColumnSpacing="0.3">
        <ChartCornerRadius TopRight="10" BottomRight="10" />
    </ChartSeries>

    <ChartSeries DataSource="@salesReport"
                 XName="Year"
                 YName="XiaomiSales"
                 Type="ChartSeriesType.Bar"
                 Fill="url(#xiaomiGradient)"
                 Opacity="0.8"
                 Name="Xiaomi"
                 ColumnSpacing="0.3">
        <ChartCornerRadius TopRight="10" BottomRight="10" />
    </ChartSeries>

    <ChartSeries DataSource="@salesReport"
                 XName="Year"
                 YName="OppoSales"
                 Type="ChartSeriesType.Bar"
                 Fill="url(#oppoGradient)"
                 Opacity="0.8"
                 Name="Oppo"
                 ColumnSpacing="0.3">
        <ChartCornerRadius TopRight="10" BottomRight="10" />
    </ChartSeries>
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class SmartphoneSalesData
    {
        public string Year { get; set; } = string.Empty;
        public double AppleSales { get; set; }
        public double XiaomiSales { get; set; }
        public double OppoSales { get; set; }
    }

    public List<SmartphoneSalesData> salesReport = new()
    {
        new() { Year = "2021", AppleSales = 237, XiaomiSales = 190, OppoSales = 143 },
        new() { Year = "2022", AppleSales = 226.4, XiaomiSales = 153.1, OppoSales = 103.3 },
        new() { Year = "2023", AppleSales = 234.6, XiaomiSales = 145.9, OppoSales = 103.1 }
    };
}
