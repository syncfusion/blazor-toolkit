<SfChart @key="@_currentTheme" Title="Steel Production by Countries, Grouped by Continent" Theme="@_currentTheme">
    <!-- X Axis -->
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" Interval="1" />

    <!-- Y Axis -->
    <ChartPrimaryYAxis Maximum="60" Interval="10" Format="{value} Mmt">
    </ChartPrimaryYAxis>

    <!-- Legend & Tooltip -->
    <ChartLegendSettings Visible="true" />
    <ChartTooltipSettings Enable="true" />

    <!-- Series -->
    <!-- Asia Group -->
    <ChartSeries DataSource="@StackingColumnGroupData"
                 XName="X" YName="Y1"
                 Name="Iran"
                 Type="ChartSeriesType.StackingBar"
                 StackingGroup="Asia"
                 Fill="#E195AB"
                 ColumnSpacing="0.2"
                 TooltipMappingName="Total">
        <ChartSeriesBorder Width="1" Color="White" />
    </ChartSeries>

    <ChartSeries DataSource="@StackingColumnGroupData"
                 XName="X" YName="Y2"
                 Name="Indonesia"
                 Type="ChartSeriesType.StackingBar"
                 StackingGroup="Asia"
                 Fill="#7E99A3"
                 ColumnSpacing="0.2"
                 TooltipMappingName="Total"
                 CornerRadius="@(new ChartCornerRadius { BottomRight = 10, TopRight = 10 })">
        <ChartSeriesBorder Width="1" Color="White" />
    </ChartSeries>

    <!-- Europe Group -->
    <ChartSeries DataSource="@StackingColumnGroupData"
                 XName="X" YName="Y3"
                 Name="Italy"
                 Type="ChartSeriesType.StackingBar"
                 StackingGroup="Europe"
                 Fill="#67BFA2"
                 ColumnSpacing="0.2"
                 TooltipMappingName="Total">
        <ChartSeriesBorder Width="1" Color="White" />
    </ChartSeries>

    <ChartSeries DataSource="@StackingColumnGroupData"
                 XName="X" YName="Y4"
                 Name="France"
                 Type="ChartSeriesType.StackingBar"
                 StackingGroup="Europe"
                 Fill="#B2CD9C"
                 ColumnSpacing="0.2"
                 TooltipMappingName="Total"
                 CornerRadius="@(new ChartCornerRadius { BottomRight = 10, TopRight = 10 })">
        <ChartSeriesBorder Width="1" Color="White" />
    </ChartSeries>
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class StackingColumnGroupDataModel
    {
        public string X { get; set; } = string.Empty;
        public double Y1 { get; set; }
        public double Y2 { get; set; }
        public double Y3 { get; set; }
        public double Y4 { get; set; }
    }

    public List<StackingColumnGroupDataModel> StackingColumnGroupData = new()
    {
        new() { X = "2018", Y1 = 24.5, Y2 = 6.2, Y3 = 24.5, Y4 = 15.4 },
        new() { X = "2019", Y1 = 25.6, Y2 = 15.6, Y3 = 23.2, Y4 = 21.1 },
        new() { X = "2020", Y1 = 29, Y2 = 14.3, Y3 = 20.4, Y4 = 13.9 },
        new() { X = "2021", Y1 = 28.5, Y2 = 9.3, Y3 = 23.2, Y4 = 11.6 },
        new() { X = "2022", Y1 = 30.6, Y2 = 7.8, Y3 = 24.5, Y4 = 14.4 }
    };
}
