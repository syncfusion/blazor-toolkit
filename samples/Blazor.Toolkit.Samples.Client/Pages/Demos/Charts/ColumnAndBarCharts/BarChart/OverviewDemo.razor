<SfChart @key="@_currentTheme" Title="Global Smartphone Sales Trends by Brand (2021-2023)" Theme="@_currentTheme">
    <!-- X Axis -->
    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Toolkit.ValueType.Category" />

    <!-- Y Axis -->
    <ChartPrimaryYAxis Format="{value}M" Title="Units Sold (in Millions)" Maximum="300">
        <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
    </ChartPrimaryYAxis>

    <!-- Tooltip -->
    <ChartTooltipSettings Enable="true"
                          Header="<b>${series.name}</b>"
                          Format="${point.x} : <b>${point.y}</b>">
    </ChartTooltipSettings>

    <!-- Series -->
    <ChartSeries DataSource="@AppleData"
                 XName="Year"
                 YName="Count"
                 Type="ChartSeriesType.Bar"
                 Fill="#8AA624"
                 Name="Apple"
                 ColumnSpacing="0.3"
                 CornerRadius="@(new ChartCornerRadius { TopRight = 8, BottomRight = 8 })">
    </ChartSeries>

    <ChartSeries DataSource="@XiaomiData"
                 XName="Year"
                 YName="Count"
                 Type="ChartSeriesType.Bar"
                 Fill="#D25D5D"
                 Name="Xiaomi"
                 ColumnSpacing="0.3"
                 CornerRadius="@(new ChartCornerRadius { TopRight = 8, BottomRight = 8 })">
    </ChartSeries>

    <ChartSeries DataSource="@OppoData"
                 XName="Year"
                 YName="Count"
                 Type="ChartSeriesType.Bar"
                 Fill="#239BA7"
                 Name="Oppo"
                 ColumnSpacing="0.3"
                 CornerRadius="@(new ChartCornerRadius { TopRight = 8, BottomRight = 8 })">
    </ChartSeries>
</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class SmartPhoneData
    {
        public string Year { get; set; } = string.Empty;
        public double Count { get; set; }
    }

    public List<SmartPhoneData> AppleData = new()
    {
        new() { Year = "2021", Count = 237 },
        new() { Year = "2022", Count = 226.4 },
        new() { Year = "2023", Count = 234.6 }
    };

    public List<SmartPhoneData> XiaomiData = new()
    {
        new() { Year = "2021", Count = 190 },
        new() { Year = "2022", Count = 153.1 },
        new() { Year = "2023", Count = 145.9 }
    };

    public List<SmartPhoneData> OppoData = new()
    {
        new() { Year = "2021", Count = 143 },
        new() { Year = "2022", Count = 103.3 },
        new() { Year = "2023", Count = 103.1 }
    };
}
