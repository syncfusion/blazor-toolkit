<SfChart @key="@_currentTheme" Theme="@_currentTheme">
    <ChartTitleStyle Color="@TextColor" />
    <ChartTooltipSettings Enable="true" Header="${point.tooltip}" Format="Height: <b>${point.x} in</b><br/>Weight: <b>${point.y} kg</b>" />

    <ChartPrimaryXAxis Title="Shoulder Breadth (cm)" Minimum="45" Maximum="50" ValueType="Syncfusion.Blazor.Toolkit.ValueType.Double">
        <ChartAxisLabelStyle Color="@TextColor" />
    </ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title="Bust Chest Circumference (cm)" Minimum="70" Maximum="140" Interval="20" RangePadding="ChartRangePadding.None">
        <ChartAxisLabelStyle Color="@TextColor" />
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@Shape2Value" Name="11-26 Years" LegendShape="LegendShape.Circle" Fill="#635DE5" EnableTooltip="true" Opacity="0.4" XName="Breadth" YName="Circumference" Type="ChartSeriesType.Scatter">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" Height="18" Width="18">
        </ChartMarker>
    </ChartSeries>
    <ChartSeries DataSource="@Shape3Value" Name="26-30 years" LegendShape="LegendShape.Circle" Fill="#FFA330" EnableTooltip="true" Opacity="0.4" XName="Breadth" YName="Circumference" Type="ChartSeriesType.Scatter">
        <ChartMarker Visible="true" Shape="ChartShape.Circle" Height="8" Width="8">
        </ChartMarker>
    </ChartSeries>
</SfChart>

