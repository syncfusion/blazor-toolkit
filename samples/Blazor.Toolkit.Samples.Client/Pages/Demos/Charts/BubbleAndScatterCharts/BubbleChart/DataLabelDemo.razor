<SfChart @key="@_currentTheme" Title="World Countries Details" Theme="@_currentTheme">
    <ChartTitleStyle Color="@TextColor" />
    <ChartTooltipSettings Enable="true"
                          Header="${point.tooltip}"
                          Format="Literacy Rate : <b>${point.x}%</b><br/>
            GDP Annual Growth Rate : <b>${point.y}</b><br/>
            Population : <b>${point.size} Billion</b>" />
    <ChartPrimaryXAxis Title="Literacy Rate" Minimum="65" Maximum="102" Interval="5">
        <ChartAxisLabelStyle Color="@TextColor" />
        <ChartStriplines>
            <ChartStripline Visible="true"
                            Start="70"
                            End="70.1"
                            Color="Gray"
                            DashArray="3,10"
                            Opacity="0.8">
                <ChartStriplineBorder></ChartStriplineBorder>
            </ChartStripline>
        </ChartStriplines>
    </ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title="GDP Annual Growth Rate" Format="n1" Minimum="-1" Maximum="10" Interval="2.5">
        <ChartAxisLabelStyle Color="@TextColor" />
        <ChartStriplines>
            <ChartStripline Visible="true"
                            Start="1.5"
                            End="1.6"
                            Color="Gray"
                            DashArray="10,1"
                            Opacity="0.8" />
        </ChartStriplines>
    </ChartPrimaryYAxis>

    <ChartSeries DataSource="@BubbleChartData.Data"
                 Type="ChartSeriesType.Bubble"
                 XName="X"
                 YName="Y"
                 Size="Size"
                 Opacity="0.6"
                 Fill="#8EC3F2"
                 MinRadius="3"
                 MaxRadius="6"
                 TooltipMappingName="ToolTipMappingName">

        <ChartMarker>
            <ChartDataLabel Visible="true"
                            Position="ChartLabelPosition.Middle" />
        </ChartMarker>
    </ChartSeries>

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    private bool IsDarkTheme => _currentTheme.ToString().Contains("Dark") || _currentTheme.ToString().Contains("HighContrast");

    private string TextColor => IsDarkTheme ? "#E6EEF8" : "#0B1F3B";

    public class BubbleData
    {
        public double X { get; set; }
