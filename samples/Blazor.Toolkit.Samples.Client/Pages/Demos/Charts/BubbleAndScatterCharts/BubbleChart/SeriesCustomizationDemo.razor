<SfChart @key="@_currentTheme" Title="World Countries Details" Theme="@_currentTheme">
    <ChartTooltipSettings Enable="true"
                          Header="${point.tooltip}"
                          Format="Literacy Rate : <b>${point.x}%</b><br/>
            GDP Annual Growth Rate : <b>${point.y}</b><br/>
            Population : <b>${point.size} Billion</b>" />
    <ChartPrimaryXAxis Title="Literacy Rate" Minimum="65" Maximum="102" Interval="5">
        <ChartStriplines>
            <ChartStripline Visible="true"
                            Start="70"
                            End="70.1"
                            Color="Gray"
                            DashArray="3,10"
                            Opacity="0.8">
                <ChartStriplineBorder></ChartStriplineBorder>
            </ChartStripline>
        </ChartStriplines>
    </ChartPrimaryXAxis>
    <ChartPrimaryYAxis Title="GDP Annual Growth Rate" Format="n1" Minimum="-1" Maximum="10" Interval="2.5">
        <ChartStriplines>
            <ChartStripline Visible="true"
                            Start="1.5"
                            End="1.6"
                            Color="Gray"
                            DashArray="10,1"
                            Opacity="0.8" />
        </ChartStriplines>
    </ChartPrimaryYAxis>

    <ChartSeries XName="X" YName="Y" Type="ChartSeriesType.Bubble" Size="Size" Fill="#F7CAC9" DataSource="@BubbleCustomSeriesData.FirstSeries" Opacity="0.7" />
    <ChartSeries XName="X" YName="Y" Type="ChartSeriesType.Bubble" Size="Size" Fill="#88B04B" DataSource="@BubbleCustomSeriesData.SecondSeries" Opacity="0.7" />
    <ChartSeries XName="X" YName="Y" Type="ChartSeriesType.Bubble" Size="Size" Fill="#6B5B95" DataSource="@BubbleCustomSeriesData.ThirdSeries" Opacity="0.7" />
    <ChartSeries XName="X" YName="Y" Type="ChartSeriesType.Bubble" Size="Size" Fill="#FF6F61" DataSource="@BubbleCustomSeriesData.FourthSeries" Opacity="0.7" />

</SfChart>

@code {
    [CascadingParameter]
    private Theme CurrentTheme { get; set; } = Theme.Fluent;

    private Theme _currentTheme = Theme.Fluent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _currentTheme = CurrentTheme;
    }

    public class BubbleCustomData
    {
        public double X { get; set; }
        public string Text { get; set; }
        public double Y { get; set; }
        public double Size { get; set; }
    }

    public static class BubbleCustomSeriesData
    {
        public static List<BubbleCustomData> FirstSeries = new()
