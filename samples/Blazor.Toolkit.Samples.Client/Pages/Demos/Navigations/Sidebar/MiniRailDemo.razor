@code {
    private bool _isOpen = true;
    private bool _openOnHover;
    private int _selectedItemIndex;
    private bool _miniExpandedByHover;
    private readonly ElementReference[] _navigationItems = new ElementReference[8];

    private int VisibleNavigationItemCount => _isOpen || _miniExpandedByHover ? _navigationItems.Length : 6;

    private void Toggle() => _isOpen = !_isOpen;

    private void SelectNavigationItem(int index) => _selectedItemIndex = index;

    private void HandleOpenOnHoverChanged(bool enabled)
    {
        _openOnHover = enabled;
        if (!enabled)
        {
            _miniExpandedByHover = false;
            if (_selectedItemIndex >= 6)
            {
                _selectedItemIndex = 0;
            }
        }
    }

    private void HandleMiniPointerEnter()
    {
        if (_openOnHover && !_isOpen)
        {
            _miniExpandedByHover = true;
        }
    }

    private async Task HandleMiniPointerLeave()
    {
        _miniExpandedByHover = false;
        if (_selectedItemIndex >= 6)
        {
            SelectNavigationItem(0);
            await _navigationItems[0].FocusAsync();
        }
    }

    private async Task HandleNavigationKeyDown(KeyboardEventArgs args, int currentIndex)
    {
        if (currentIndex >= VisibleNavigationItemCount)
        {
            return;
        }

        int itemCount = VisibleNavigationItemCount;
        int nextIndex = args.Key switch
        {
            "ArrowDown" => (currentIndex + 1) % itemCount,
            "ArrowUp" => (currentIndex - 1 + itemCount) % itemCount,
            "Home" => 0,
            "End" => itemCount - 1,
            _ => currentIndex
        };

        if (nextIndex != currentIndex)
        {
            SelectNavigationItem(nextIndex);
            await _navigationItems[nextIndex].FocusAsync();
        }
        else if (args.Key == "Enter")
        {
            SelectNavigationItem(currentIndex);
        }
    }
}

