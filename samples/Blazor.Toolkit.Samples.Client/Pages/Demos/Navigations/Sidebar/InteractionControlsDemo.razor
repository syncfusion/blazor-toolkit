<div class="sbd-controls">
    <SfCheckBox TChecked="bool" Label="ShowBackdrop" @bind-Checked="_showBackdrop" />
    <SfCheckBox TChecked="bool" Label="CloseOnOverlayClick" Disabled="@(!_showBackdrop)" @bind-Checked="_closeOnOverlayClick" />
    <SfCheckBox TChecked="bool" Label="CloseOnEscape" @bind-Checked="_closeOnEscape" />
</div>

<p class="sbd-note">Open the sidebar, then try Escape or click the backdrop. The options can be changed while the sidebar is open.</p>

<div class="sbd-stage">
    <SfSidebar Id="sbd-interaction"
               @bind-IsOpen="_isOpen"
               Mode="SidebarMode.Overlay"
               ShowBackdrop="_showBackdrop"
               CloseOnOverlayClick="_closeOnOverlayClick"
               CloseOnEscape="_closeOnEscape"
               Responsive="false"
               Fixed="false"
               Width="260px"
               AriaLabel="Interaction navigation">
        <HeaderTemplate>
            <div class="sbd-panel-heading">
                <h3 class="h6 m-0">Navigation</h3>
                <SfButton CssClass="e-flat sbd-corner-close" IconCss="sb-icons e-close" aria-label="Close navigation" OnClick="Close" />
            </div>
        </HeaderTemplate>
        <ChildContent>
            <ul class="sbd-nav">
                <li>Inbox</li>
                <li>Sent</li>
                <li>Archive</li>
            </ul>
        </ChildContent>
        <TargetContent>
            <div class="sbd-content sbd-interaction-content">
                <div>
                    <SfButton CssClass="e-primary"
                              IconCss="sb-icons e-menu"
                              aria-controls="sbd-interaction"
                              aria-expanded="@(_isOpen ? "true" : "false")"
                              OnClick="Toggle">Menu</SfButton>
                </div>
                <p><strong>Backdrop:</strong> @(_showBackdrop ? "shown" : "hidden"). <strong>Backdrop click:</strong> @(_showBackdrop && _closeOnOverlayClick ? "closes" : "ignored"). <strong>Escape:</strong> @(_closeOnEscape ? "closes" : "ignored").</p>
                <p>Without a backdrop the panel is not modal, so the page behind it stays reachable.</p>
            </div>
        </TargetContent>
    </SfSidebar>
</div>

@code {
    private bool _isOpen;
    private bool _showBackdrop = true;
    private bool _closeOnOverlayClick = true;
    private bool _closeOnEscape = true;

    private void Toggle() => _isOpen = !_isOpen;

    private void Close() => _isOpen = false;
}

<style>
    .sbd-interaction-content {
        background: color-mix(in srgb, #e2e3e5 22%, var(--color-sf-content-bg-color, #fff));
    }

    .sbd-panel-heading {
        position: relative;
        min-height: 2rem;
        padding-inline-end: 2.25rem;
    }

    .sbd-corner-close.e-btn {
        position: absolute;
        top: 0;
        inset-inline-end: 0;
        width: 2rem;
        height: 2rem;
        padding: 0;
    }
</style>
