<div class="tb-templates" data-testid="toolbar-templates-demo">
    <SfToolbar AriaLabel="Workspace actions" OverflowMode="ToolbarOverflowMode.Popup" data-testid="toolbar-root">
        <ToolbarGroup Label="Workspace actions">
            <ToolbarItem Text="Ascending" IconCss="e-icons e-arrow-up" Tooltip="Sort files ascending" OnClick="SortAscending" />
            <ToolbarItem Text="Descending" IconCss="e-icons e-arrow-down" Tooltip="Sort files descending" OnClick="SortDescending" />
        </ToolbarGroup>
        <ToolbarSeparator />
        <ToolbarSpacer />
        <ToolbarItem Id="workspace-search" Text="Search workspace" Type="ToolbarItemType.Template" Overflow="ToolbarOverflowOption.Show" Priority="-20">
            <Template>
                <label class="tb-search">
                    <span class="sb-icons e-search" aria-hidden="true"></span>
                    <input value="@_query" @oninput="OnQuery" @onkeydown:stopPropagation="true" placeholder="Search workspace" aria-label="Search workspace" />
                    @if (!string.IsNullOrEmpty(_query))
                    {
                        <button type="button" class="tb-clear" aria-label="Clear search" @onclick="Clear" @onkeydown:stopPropagation="true">×</button>
                    }
                </label>
            </Template>
        </ToolbarItem>
        <ToolbarItem Id="workspace-status" Text="Workspace status" Type="ToolbarItemType.Template" Overflow="ToolbarOverflowOption.Show" Priority="-10">
            <Template>
                <span class="tb-chip" aria-live="polite">@ResultLabel</span>
            </Template>
        </ToolbarItem>
        <ToolbarItem Id="workspace-view" Text="Workspace view" Type="ToolbarItemType.Template" Overflow="ToolbarOverflowOption.Hide" Priority="10">
            <Template>
                <div class="tb-view-toggle" role="group" aria-label="Workspace view">
                    <button type="button" class="@ViewButtonClass(false)" aria-pressed="@(!_isGrid)" @onclick="() => SetView(false)" @onkeydown:stopPropagation="true">List</button>
                    <button type="button" class="@ViewButtonClass(true)" aria-pressed="@_isGrid" @onclick="() => SetView(true)" @onkeydown:stopPropagation="true">Grid</button>
                </div>
            </Template>
        </ToolbarItem>
        <ToolbarItem Text="Refresh" IconCss="sb-icons e-refresh" Tooltip="Restore sample files" OnClick="RefreshWorkspace" />
    </SfToolbar>

    <ul class="tb-files @(_isGrid ? "is-grid" : "is-list")" aria-label="Workspace files">
        @foreach (string item in VisibleItems)
        {
            <li class="tb-file">
                <span class="sb-icons e-file-new" aria-hidden="true"></span>
                <span class="tb-file-name">@item</span>
            </li>
        }
        @if (!VisibleItems.Any())
        {
            <li class="tb-files-empty" aria-live="polite">No files match your search.</li>
        }
    </ul>
</div>

@code {
    private static readonly string[] InitialWorkspaceItems =
    [
        "Q3 roadmap.docx",
        "Launch notes.md",
        "Budget.xlsx",
        "Brand guidelines.pdf",
        "Interview schedule.docx",
        "Release checklist.md"
    ];

    private readonly List<string> _workspaceItems = [.. InitialWorkspaceItems];
    private string _query = string.Empty;
    private bool _isGrid;
    private bool _sortDescending;

    private IEnumerable<string> VisibleItems
    {
        get
        {
            IEnumerable<string> items = _workspaceItems.Where(item =>
                string.IsNullOrWhiteSpace(_query) || item.Contains(_query, StringComparison.OrdinalIgnoreCase));

            return _sortDescending
                ? items.OrderByDescending(item => item, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(item => item, StringComparer.OrdinalIgnoreCase);
        }
    }

    private string ResultLabel => $"{VisibleItems.Count()} files";

    private void OnQuery(ChangeEventArgs args) => _query = args.Value?.ToString() ?? string.Empty;

    private void Clear() => _query = string.Empty;

    private void SetView(bool isGrid) => _isGrid = isGrid;

    private Task SortAscending()
    {
        _sortDescending = false;
        return Task.CompletedTask;
    }

    private Task SortDescending()
    {
        _sortDescending = true;
        return Task.CompletedTask;
    }

    private void RefreshWorkspace()
    {
        _workspaceItems.Clear();
        _workspaceItems.AddRange(InitialWorkspaceItems);
        _query = string.Empty;
        _sortDescending = false;
        _isGrid = false;
    }

    private string ViewButtonClass(bool isGrid) => _isGrid == isGrid ? "tb-view-button is-active" : "tb-view-button";
}