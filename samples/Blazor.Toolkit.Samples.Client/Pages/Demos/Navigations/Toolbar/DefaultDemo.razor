<div class="tb-stage">
    <div class="tb-frame" data-testid="toolbar-default-demo">
        <SfToolbar AriaLabel="Document commands" data-testid="toolbar-root">
            <ToolbarGroup Label="Document">
                <ToolbarItem Id="default-new" Text="New" IconCss="sb-icons e-file-new" Tooltip="Create a document" />
                <ToolbarItem Id="default-edit" Text="Edit" IconCss="sb-icons e-edit" Tooltip="Edit the selection" />
                <ToolbarItem Id="default-delete" Text="Delete" IconCss="sb-icons e-trash" Tooltip="Delete the selection" />
            </ToolbarGroup>
            <ToolbarSeparator />
            <ToolbarItem Id="default-refresh" Text="Refresh" IconCss="sb-icons e-refresh" Tooltip="Reload the view" />
            <ToolbarSpacer />
            <ToolbarGroup Label="View">
                <ToolbarItem Id="default-export" Text="Export" IconCss="sb-icons e-export" Tooltip="Export this document" />
                <ToolbarItem Id="default-print" Text="Print" IconCss="sb-icons e-print" Tooltip="Print" />
            </ToolbarGroup>
        </SfToolbar>
    </div>
</div>

