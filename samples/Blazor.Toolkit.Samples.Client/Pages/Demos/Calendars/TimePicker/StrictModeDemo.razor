<SfTimePicker TValue="DateTime?" Width="300px" Min="@StrictModeMinTime" Max="@StrictModeMaxTime" StrictMode=true Value="@StrictModeTimeValue" Placeholder="Select a time" ShowClearButton="true"></SfTimePicker>
@code{
    public DateTime StrictModeMinTime { get; set; } = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 15, 08, 00, 00);
    public DateTime StrictModeMaxTime { get; set; } = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 15, 16, 00, 00);
    public DateTime? StrictModeTimeValue { get; set; } = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 15, 3, 00, 00);
}