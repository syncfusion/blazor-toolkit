@page "/"
@page "/explore"
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Routing
@using System.Linq
@inject IJSRuntime JS

<PageTitle>Explore Blazor Components | Syncfusion Toolkit</PageTitle>

<div class="sf-explore">
    <div class="sf-explore-shell">

        @* ============================================================
           INTRO
           ============================================================ *@
        <header class="sf-explore-intro">
            <h1 class="sf-explore-title">Explore Syncfusion Components</h1>
            <p class="sf-explore-lede">
                Discover lightweight, open-source Blazor Toolkit components and sample
                implementations. Browse each category to find the right control for
                your next application.
            </p>

            <ul class="sf-explore-stats" aria-label="Catalog statistics">
                <li class="sf-stat">
                    <span class="sf-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                        </svg>
                    </span>
                    <span class="sf-stat-value">@TotalComponents</span>
                    <span class="sf-stat-label">Components</span>
                </li>
                <li class="sf-stat">
                    <span class="sf-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" y1="6" x2="20" y2="6"></line>
                            <line x1="4" y1="12" x2="20" y2="12"></line>
                            <line x1="4" y1="18" x2="14" y2="18"></line>
                        </svg>
                    </span>
                    <span class="sf-stat-value">@Categories.Count</span>
                    <span class="sf-stat-label">Categories</span>
                </li>
                <li class="sf-stat">
                    <span class="sf-stat-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2 4 6v6c0 5 3.5 9.4 8 10 4.5-.6 8-5 8-10V6l-8-4z"></path>
                            <polyline points="9 12 11.5 14.5 16 10"></polyline>
                        </svg>
                    </span>
                    <span class="sf-stat-value">Open Source</span>
                    <span class="sf-stat-label">MIT Licensed</span>
                </li>
            </ul>
        </header>

        @* ============================================================
           CATEGORY SECTIONS
           ============================================================ *@
        <div class="sf-categories">
            @foreach (var category in Categories)
            {
                var sectionId = $"category-{category.Name.ToLowerInvariant().Replace(" ", "-")}";
                <section class="sf-category"
                         id="@sectionId"
                         aria-labelledby="@($"{sectionId}-title")">
                    <header class="sf-category-header">
                        <span class="sf-category-icon" aria-hidden="true">
                            <i class="e-toolkit-icons @category.ToolkitIconClass" title="@category.Name"></i>
                        </span>
                        <div class="sf-category-meta">
                            <h2 class="sf-category-title" id="@($"{sectionId}-title")">
                                @category.Name
                                <span class="sf-category-count">(@category.Components.Count(c => c.Available))</span>
                            </h2>
                            <p class="sf-category-tagline">@category.Tagline</p>
                        </div>
                    </header>

                    @{
                        var components = category.Components.Where(c => c.Available).ToList();
                    }
                    @if (string.Equals(category.Name, "Inputs", StringComparison.OrdinalIgnoreCase))
                    {
                        // Inputs: strict 2-row x 4-col balanced layout per spec.
                        <div class="sf-card-grid sf-card-grid--inputs">
                            @foreach (var component in components)
                            {
                                @RenderComponentCard(component)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="sf-card-grid">
                            @foreach (var component in components)
                            {
                                @RenderComponentCard(component)
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

@code {
    // ---------------------------------------------------------------
    //  Data model
    //  Each item carries two icon classes:
    //    - IconClass         : Syncfusion `e-toolkit-icons` glyph (legacy, used in header)
    //    - ToolkitIconClass  : `e-toolkit-icons` glyph from the new font (overlays)
    // ---------------------------------------------------------------
    private record ComponentItem(
        string Name,
        string Href,
        string IconClass,
        string ToolkitIconClass,
        bool Available = true);

    private record Category(
        string Name,
        string Tagline,
        string IconClass,
        string ToolkitIconClass,
        List<ComponentItem> Components);

    // ---------------------------------------------------------------
    //  Catalog (sync'd with the NavMenu component set)
    //  Every category uses a real Syncfusion `e-toolkit-icons` glyph so the
    //  brand blue stays consistent across the page.
    // ---------------------------------------------------------------
    private List<Category> Categories = new()
    {
        new("Charts",     "Line, Area, Column and Bar Charts",     "e-chart-2d-clustered-column", "e-chart",       new List<ComponentItem>
        {
            new("Chart", "charts/overview", "ci-chart",       "e-chart"),
        }),

        new("Buttons",    "Regular, Icon and FAB buttons",         "e-button-field",              "e-button",      new List<ComponentItem>
        {
            new("Button",       "buttons/button",       "ci-button",       "e-button"),
            new("Button Group", "buttons/button-group", "ci-buttongroup",  "e-button"),
        }),

        new("Calendars",  "Date and Time Pickers",                "e-agenda-date-range",         "e-calendars",   new List<ComponentItem>
        {
            new("Calendar",         "calendars/calendar",         "ci-calendar",     "e-calendars"),
            new("DatePicker",       "calendars/datepicker",       "ci-datepicker",   "e-calendars"),
            new("DateTime Picker",  "calendars/datetimepicker",   "ci-datetime",     "e-calendars"),
            new("TimePicker",       "calendars/timepicker",       "ci-timepicker",   "e-calendars"),
        }),

        new("Spinner",    "Loading Indicators",                   "e-refresh",                   "e-spinner",     new List<ComponentItem>
        {
            new("Spinner", "spinner", "ci-spinner", "e-spinner"),
        }),

        new("Inputs",     "Forms and Selection Controls",         "e-form-field",                "e-input",       new List<ComponentItem>
        {
            new("Checkbox",       "inputs/checkbox",        "ci-checkbox",    "e-check"),
            new("File Upload",    "inputs/uploader",        "ci-upload",      "e-arrow-up"),
            new("Numeric TextBox","inputs/numerictextbox",  "ci-numeric",     "e-input"),
            new("TextArea",       "inputs/textarea",        "ci-textarea",    "e-input"),
            new("TextBox",        "inputs/textbox",         "ci-textbox",     "e-input"),
            new("Radio Button",   "inputs/radio-button",    "ci-radio",       "e-circle-remove"),
            new("Switch",         "inputs/switch",          "ci-switch",      "e-intermediate-state-2"),
        }),

        new("Popups",     "Dialogs and Tooltips",                 "e-box",                       "e-popups",      new List<ComponentItem>
        {
            new("Dialog",  "popups/dialog",  "ci-dialog",  "e-popups"),
            new("Tooltip", "popups/tooltip", "ci-tooltip", "e-popups"),
        }),
    };

    private static readonly Dictionary<string, string> IconSvgFiles = new(StringComparer.OrdinalIgnoreCase)
    {
        ["ci-chart"] = "Charts.svg",
        ["ci-button"] = "Button.svg",
        ["ci-buttongroup"] = "Button Group.svg",
        ["ci-calendar"] = "Calendar.svg",
        ["ci-datepicker"] = "Date Picker.svg",
        ["ci-datetime"] = "DateTime Picker.svg",
        ["ci-timepicker"] = "TimePicker.svg",
        ["ci-spinner"] = "Spinners.svg",
        ["ci-checkbox"] = "Check Box.svg",
        ["ci-upload"] = "File Upload.svg",
        ["ci-numeric"] = "Numeric TextBox.svg",
        ["ci-textarea"] = "TextArea.svg",
        ["ci-textbox"] = "Textbox.svg",
        ["ci-radio"] = "Radio Button.svg",
        ["ci-switch"] = "Switch.svg",
        ["ci-dialog"] = "Dialog.svg",
        ["ci-tooltip"] = "Tooltip.svg"
    };

    private int TotalComponents => Categories.Sum(c => c.Components.Count(x => x.Available));

    // ---------------------------------------------------------------
    //  Theme state
    // ---------------------------------------------------------------
    private bool _isDarkTheme;
    private DotNetObjectReference<Explore>? _themeRef;
    private bool _revealInitialized;

    private string GetIconPath(string iconClass)
    {
        var folder = _isDarkTheme ? "svg-dark" : "svg-light";

        return IconSvgFiles.TryGetValue(iconClass, out var fileName)
            ? $"{folder}/{fileName}"
            : $"{folder}/Charts.svg";
    }

    private RenderFragment RenderComponentCard(ComponentItem component) => __builder =>
    {
        <NavLink class="sf-component-card"
                 href="@component.Href"
                 Match="NavLinkMatch.All">
            <span class="sf-component-preview" aria-hidden="true">
                <img class="sf-component-preview-img"
                     src="@GetIconPath(component.IconClass)"
                     alt="@($"{component.Name} preview")"
                     loading="lazy" />
            </span>
            <span class="sf-component-meta">
                <span class="sf-component-name">@component.Name</span>
                <span class="sf-component-link">
                    Explore
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </span>
            </span>
        </NavLink>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_revealInitialized)
        {
            _revealInitialized = true;
            try
            {
                await JS.InvokeVoidAsync("scrollEffects.initReveal", ".sf-component-card");
            }
            catch { /* fail silently if JS not available */ }
        }

        if (firstRender)
        {
            try
            {
                var currentTheme = await JS.InvokeAsync<string>("mainLayout.initTheme");
                _isDarkTheme = currentTheme == "dark";
                await InvokeAsync(StateHasChanged);
                _themeRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("mainLayout.observeTheme", _themeRef);
            }
            catch { /* fail silently if JS not available */ }
        }
    }

    [JSInvokable]
    public Task NotifyThemeChanged(string theme)
    {
        var isDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);

        if (_isDarkTheme != isDarkTheme)
        {
            _isDarkTheme = isDarkTheme;
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_revealInitialized)
        {
            try { await JS.InvokeVoidAsync("scrollEffects.dispose"); } catch { }
        }

        try { await JS.InvokeVoidAsync("mainLayout.disposeThemeObserver"); } catch { }

        _themeRef?.Dispose();
    }
}

<style>
    /* ===========================================================
       Syncfusion Blazor Toolkit V2 — Explore page
       Brand:  #2B357C (primary) / #3948A5 (hover) / #F5F7FC (surface)
       Type:   Segoe UI Variable -> Inter
       Spine:  1200px max-width, 48px section gap, 16px card gap
       =========================================================== */

    .sf-explore {
        --sf-x-page: #FFFFFF;
        --sf-x-soft: #F5F7FC;
        --sf-x-soft-2: #F9FAFB;
        --sf-x-border: #E5E7EB;
        --sf-x-border-strong: #D1D5DB;
        --sf-x-text: #111827;
        --sf-x-text-muted: #6B7280;
        --sf-x-accent: #2B357C;
        --sf-x-accent-hover: #3948A5;
        --sf-x-accent-soft: rgba(43, 53, 124, 0.10);
        --sf-x-accent-tint: rgba(43, 53, 124, 0.06);
        --sf-x-card-shadow: 0px 1px 2px rgba(15, 23, 42, 0.04);
        --sf-x-card-hover-shadow: 0px 4px 12px rgba(15, 23, 42, 0.08);

        font-family: "Segoe UI Variable", "Segoe UI", "Inter", Roboto, system-ui, -apple-system, sans-serif;
        font-size: 16px;
        line-height: 1.65;
        color: var(--sf-x-text);
        background: var(--sf-x-page);
        transition: background-color .2s ease, color .2s ease;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .dark .sf-explore,
    [data-theme="dark"] .sf-explore {
        --sf-x-page: #0B1220;
        --sf-x-soft: #0F172A;
        --sf-x-soft-2: #111827;
        --sf-x-border: #1F2937;
        --sf-x-border-strong: #374151;
        --sf-x-text: #E5E7EB;
        --sf-x-text-muted: #9CA3AF;
        --sf-x-accent: #8A93C4;
        --sf-x-accent-hover: #A4ABE0;
        --sf-x-accent-soft: rgba(138, 147, 196, 0.18);
        --sf-x-accent-tint: rgba(138, 147, 196, 0.10);
        --sf-x-card-shadow: 0px 1px 2px rgba(0, 0, 0, 0.35);
        --sf-x-card-hover-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    }

    /* Let the explore shell own the page padding so the 1200px
       max-width and 32px gutter are honoured exactly. */
    .main-area-full-width:has(.sf-explore) {
        padding: 0;
    }

    .sf-explore-shell {
        padding: 20px 20px 20px 20px;
    }

    /* ===========================================================
       INTRO  (title, lede, stats)
       =========================================================== */
    .sf-explore-intro {
        padding: 0 0 16px;
    }

    .sf-explore-title {
        margin: 0 0 10px;
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif;
        font-size: 42px;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--sf-x-text);
    }

    .sf-explore-lede {
        margin: 0 0 16px;
        max-width: 760px;
        font-size: 16px;
        font-weight: 400;
        line-height: 1.6;
        color: var(--sf-x-text-muted);
    }

    .sf-explore-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 28px;
        padding: 10px 0;
        margin: 0 0 -40px 0 !important;
        list-style: none;
        border-top: 1px solid var(--sf-x-border);
    }

    .sf-stat {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: var(--sf-x-text);
    }

    /* Every icon in the page uses the same brand-blue tint:
       soft tinted background + #2B357C foreground.            */
    .sf-stat-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: var(--sf-x-accent-soft);
        color: var(--sf-x-accent);
        flex-shrink: 0;
    }
    .sf-stat-icon svg { display: block; }

    .sf-stat-value {
        font-weight: 600;
        letter-spacing: -0.01em;
        font-size: 15px;
        color: var(--sf-x-text);
    }
    .sf-stat-label {
        font-size: 15px;
        color: var(--sf-x-text-muted);
        font-weight: 400;
    }

    /* ===========================================================
       CATEGORY SECTIONS
       Single visual group: [icon] | [title + description]
       =========================================================== */
    .sf-categories { display: block; }

    .sf-category {
        padding: 24px 0 0;
        border-top: 1px solid var(--sf-x-border);
        margin-top: 24px;
    }
    .sf-category:first-child {
        margin-top: 16px;
    }

    /* Single horizontal row:
       [ icon-box ]   [ title (with count) ]
                      [ tagline             ]                              */
    .sf-category-header {
        display: flex;
        flex-direction: row;
        gap: 14px;
    }

    /* The global .page-content h2 rule adds a border-bottom and
       padding that breaks the category header. Reset them here so
       the title sits flush with the icon row and the tagline.      */
    .sf-explore h1,
    .sf-explore h2,
    .sf-explore h3 {
        margin: 0;
        padding: 0;
        border: 0;
        letter-spacing: -0.01em;
    }

    .sf-category-icon {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        color: var(--sf-x-accent);
        position: relative;
    }
    /* New e-toolkit-icons glyph: positioned as a top-right badge so
       it does not collide with the legacy e-toolkit-icons glyph. */
    .sf-category-icon .e-toolkit-icons {
        position: absolute;
        top: -4px;
        right: -6px;
        font-size: 40px;
        font-weight: 600;
        line-height: 1;
        color: var(--sf-x-accent);
        background: var(--sf-x-accent-soft);
        border: 1px solid var(--sf-x-border);
        border-radius: 4px;
        padding: 2px 3px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }

    .sf-category-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        min-width: 0;
        flex: 1 1 auto;
    }

    .sf-category-title {
        margin: 0 !important;
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", sans-serif !important;
        font-size: 22px !important;
        font-weight: 600 !important;
        letter-spacing: -0.01em !important;
        line-height: 1.25 !important;
        color: var(--sf-x-text) !important;
        display: inline-flex !important;
        align-items: baseline !important;
        gap: 8px !important;
        padding-bottom: 0 !important;
        margin: 0 !important;
        border-bottom: none !important;
    }

    .sf-category-count {
        font-size: 25px;
        font-weight: 500;
        color: var(--sf-x-text-muted);
        letter-spacing: 0;
    }

    .sf-category-tagline {
        margin: 0 !important;
        font-size: 14px !important;
        color: var(--sf-x-text-muted) !important;
        font-weight: 400 !important;
        line-height: 1.5 !important;
    }

    /* ===========================================================
       COMPONENT CARDS
       Vertical layout: icon occupies the major area on top,
       component name + "Explore" link sit below in a smaller row.
       =========================================================== */
    .sf-card-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    /* Inputs: strict 2-row x 4-col balanced layout per spec. */
    .sf-card-grid--inputs {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 16px;
        max-width: 760px;
    }

    @@media (max-width: 900px) {
        .sf-card-grid--inputs {
            grid-template-columns: repeat(2, minmax(180px, 1fr));
            max-width: none;
        }
    }

    .sf-component-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 200px;
        min-width: 200px;
        height: 180px;
        border: 1px solid var(--sf-x-border);
        border-radius: 10px;
        background: var(--sf-x-page);
        box-shadow: var(--sf-x-card-shadow);
        text-decoration: none !important;
        color: inherit !important;
        overflow: hidden;
        transition:
            transform .18s ease,
            box-shadow .18s ease,
            border-color .18s ease,
            background-color .18s ease !important;
    }
    .sf-component-card:hover {
        transform: translateY(-2px) !important;
        border-color: var(--sf-x-accent) !important;
        box-shadow: var(--sf-x-card-hover-shadow) !important;
        color: inherit !important;
        text-decoration: none !important;
    }
    .sf-component-card:focus-visible {
        outline: 2px solid var(--sf-x-accent) !important;
        outline-offset: 2px !important;
    }

    .sf-card-grid--inputs .sf-component-card { width: 100%; min-width: 0; }

    /* Preview sits on TOP of the card and acts as the dominant
       visual anchor (large e-toolkit-icons glyph). The bottom
       row hosts the component title and the "Explore →" affordance. */
    .sf-component-preview {
        position: relative;
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 0;
        padding: 0;
        background: var(--sf-x-accent-soft);
        border-bottom: 1px solid var(--sf-x-border);
        overflow: hidden;
    }
    /* The e-toolkit-icons glyph is the primary visual on the card. */
    .sf-component-preview .sf-component-iconfont {
        font-size: 64px;
        line-height: 1;
        color: var(--sf-x-accent);
        display: inline-block;
        pointer-events: none;
        transition: transform .18s ease, color .18s ease;
    }
    .sf-component-card:hover .sf-component-preview .sf-component-iconfont {
        transform: scale(1.06);
        color: var(--sf-x-accent-hover);
    }
    .sf-component-preview-img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        filter: saturate(1.05);
        transition: transform .18s ease;
    }
    .sf-component-card:hover .sf-component-preview-img {
        transform: scale(1.04);
    }

    /* Compact bottom row: component name on the left, "Explore →"
       affordance on the right. */
    .sf-component-meta {
        flex: 0 0 auto;
        min-width: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 12px;
        background: var(--sf-x-page);
    }

    .sf-component-name {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0;
        color: var(--sf-x-text);
        line-height: 1.25;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: left;
    }

    .sf-component-link {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        font-weight: 600;
        color: var(--sf-x-accent);
        line-height: 1.25;
        white-space: nowrap;
        flex: 0 0 auto;
    }
    .sf-component-card:hover .sf-component-link {
        color: var(--sf-x-accent-hover);
    }
    .sf-component-link svg { display: block; }

    /* ===========================================================
       RESPONSIVE
       =========================================================== */
    @@media (max-width: 1024px) {
        .sf-explore-shell { padding: 28px 24px 56px 24px; }
        .sf-explore-title { font-size: 34px; }
        .sf-component-card { width: 180px; min-width: 180px; height: 160px; }
    }

    @@media (max-width: 640px) {
        .sf-explore-shell { padding: 20px 16px 40px 16px; }
        .sf-explore-title { font-size: 28px; }
        .sf-explore-stats {
            flex-direction: column;
            gap: 8px;
            align-items: flex-start;
        }
        .sf-category { padding-top: 20px; margin-top: 20px; }
        .sf-category-header { gap: 12px; margin-bottom: 12px; }
        .sf-category-icon { width: 36px; height: 36px; }
