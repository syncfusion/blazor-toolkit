@page "/browser-support"
@inherits TocPublishingComponentBase

<PageTitle>Browser Compatibility | Syncfusion Blazor Toolkit</PageTitle>

<style>
    /* Match the Fluent 2 / Segoe UI Variable typography used on
       the Getting Started page so every doc page reads the same. */
    .page-content {
        font-family: "Segoe UI Variable", "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    .page-content code,
    .page-content pre {
        font-family: "Cascadia Code", "JetBrains Mono", "Fira Code", Consolas, "SFMono-Regular", monospace;
        font-size: 0.875em;
    }

    :root {
        /* Table-specific variables (light defaults) */
        --table-bg: var(--panel-bg);
        --table-border: rgba(0,0,0,0.06);
        --table-border-radius: 6px;
        --table-header-bg: rgba(0,0,0,0.02);
        --table-header-color: var(--top-text);
        --table-row-bg: #ffffff;
        --table-row-border: rgba(0,0,0,0.04);
    }

    .dark {
        --table-bg: var(--panel-bg);
        --table-border: rgba(255,255,255,0.10);
        --table-header-bg: rgba(255,255,255,0.04);
        --table-header-color: var(--top-text);
        --table-row-bg: rgba(255,255,255,0.01);
        --table-row-border: rgba(255,255,255,0.04);
    }

    .table {
        background-color: var(--table-bg, #ffffff);
        color: var(--text-color, #111827);
        border: 1px solid var(--table-border, rgba(0,0,0,0.06));
        border-radius: var(--table-border-radius, 6px);
        overflow: hidden;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table thead th {
        background-color: var(--table-header-bg, rgba(0,0,0,0.02));
        color: var(--table-header-color, var(--top-text, #111827));
        padding: 0.75rem 1rem;
        text-align: left;
        font-weight: 600;
        border-bottom: 1px solid var(--table-row-border, rgba(0,0,0,0.04));
    }

    .table tbody td {
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--table-row-border, rgba(0,0,0,0.04));
        background-color: var(--table-row-bg, #ffffff);
        color: var(--text-color, #111827);
    }

</style>

<Description>
    <Header>
        <h1 id="browser-support">Browser Support</h1>
    </Header>
    <Content>
        <p><a href="https://www.syncfusion.com/blazor-toolkit" target="_blank" rel="noreferrer noopener">Syncfusion<sup style="font-size:70%">&reg;</sup> Toolkit for Blazor</a> components are fully supported in modern browsers on both desktop and mobile devices running Windows, Linux, or macOS. The following table shows the specific browser versions required for optimal compatibility with Syncfusion Blazor Toolkit.</p>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="supported-browsers">Supported browsers</h2>
    </Header>
    <Content>
        <table class="table">
            <thead>
                <tr>
                    <th>Browser</th>
                    <th>Versions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Google Chrome (including Android &amp; iOS)</td>
                    <td>Latest Version</td>
                </tr>
                <tr>
                    <td>Mozilla Firefox</td>
                    <td>Latest Version</td>
                </tr>
                <tr>
                    <td>Microsoft Edge</td>
                    <td>Latest Version</td>
                </tr>
                <tr>
                    <td>Apple Safari (including iOS)</td>
                    <td>Latest Version</td>
                </tr>
            </tbody>
        </table>
    </Content>
</Description>

<Description>
    <Header>
        <h2 id="see-also">See also</h2>
    </Header>
    <Content>
        <ul>
            <li><a href="/system-requirements">System Requirements</a> - IDE and .NET SDK prerequisites</li>
            <li><a href="https://learn.microsoft.com/en-us/aspnet/core/blazor/supported-platforms" target="_blank" rel="noreferrer noopener">ASP.NET Core Blazor Supported Platforms</a> - Microsoft official documentation</li>
            <li><a href="https://blazor.syncfusion.com/demos/toolkit" target="_blank" rel="noreferrer noopener">Syncfusion Blazor Toolkit Live Demos</a> - Test components in supported browsers</li>
        </ul>
    </Content>
</Description>

@code {
    private static readonly IReadOnlyList<RightToc.TocItem> TocItemsList = new RightToc.TocItem[]
    {
        new("supported-browsers", "Supported browsers"),
        new("see-also", "See also"),
    };

    protected override IReadOnlyList<RightToc.TocItem> TocItems => TocItemsList;
}
