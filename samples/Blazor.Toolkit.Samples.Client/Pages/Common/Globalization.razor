<Description>
    <Header>
        <h2 id="localization">Localization</h2>
    </Header>
    <Content>
        <p>
            To change to a specific culture, add the corresponding <code>.resx</code> resource files and configure localization in your application.
        </p>
    </Content>
</Description>

