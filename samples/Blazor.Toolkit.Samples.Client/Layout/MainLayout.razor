@inherits LayoutComponentBase
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Web
@using Syncfusion.Blazor.Toolkit.Buttons
@using Syncfusion.Blazor.Toolkit.Popups
@using Syncfusion.Blazor.Toolkit.Inputs

@inject Syncfusion.Blazor.Toolkit.SyncfusionBlazorToolkitService SyncfusionService
@inject NavigationManager Urihelper

<div class="page">
    <header class="top-layout-custom">
        @if (IsMobile)
        {
            <div class="top-layout-title">
                <a href="https://www.syncfusion.com" target="_blank" rel="noreferrer noopener" class="brand-link" aria-label="Syncfusion home">
                    <div class="syncfusion-logo" aria-hidden="true"></div>
                </a>
                <span class="brand-divider" aria-hidden="true"></span>
                <a href="https://www.syncfusion.com/blazor-toolkit" target="_blank" rel="noreferrer noopener" class="brand-link brand-product" aria-label="Blazor Toolkit product page">
                    <span class="brand-product-name">Blazor Toolkit</span>
                </a>
            </div>
        }
        <div class="top-layout-inner">
            @{
                string topClass = IsTablet ? "top-left tablet" : "top-left";
            }
            <div class="@topClass">
                @* Top-left of the top-right area: render a hamburger button on tablet/mobile to open the nav overlay. *@
                @if (IsMobile || IsTablet)
                {
                    <SfButton CssClass="e-outline icon-button hamburger-button" IconCss="sb-icons e-menu" aria-label="Open menu" aria-controls="leftSidebar" aria-expanded="@OverlayLeftIsOpen.ToString().ToLower()" OnClick="@ToggleLeftOverlay" @onkeydown="@OnHamburgerKeyDown">
                    </SfButton>
                }
                <div class="brand-section">
                    @if (!IsMobile)
                    {
                        <a href="https://www.syncfusion.com" target="_blank" rel="noreferrer noopener" class="brand-link" aria-label="Syncfusion home">
                            <div class="syncfusion-logo" aria-hidden="true"></div>
                        </a>
                        <span class="brand-divider" aria-hidden="true"></span>
                        <a href="https://www.syncfusion.com/blazor-toolkit" target="_blank" rel="noreferrer noopener" class="brand-link brand-product" aria-label="Blazor Toolkit product page">
                            <span class="brand-product-name">Blazor Toolkit</span>
                        </a>
                    }
                </div>
            </div>
            <div class="top-right">
                @* Large, prominent search box in the header. *@
                @if (!IsMobile)
                {
                    <SfButton CssClass="e-flat topbar-search" aria-label="Search docs" OnClick="@ToggleSearchPopup">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <span class="topbar-search-text">Search docs, components, API…</span>
                    </SfButton>
                }
                else
                {
                    <div class="action-buttons">
                        <SfButton CssClass="e-outline search icon-button theme-toggle" IconCss="sb-icons e-search" aria-label="Search Components" OnClick="@ToggleSearchPopup"></SfButton>
                    </div>
                }
                
                <SfDialog @ref="@DialogObj" Width="750px" IsModal="true" @bind-Visible="@isSearchVisible" CssClass="search-popup" OnOverlayModalClick="@OnOverlayClick" OnClose="OnDialogClose">
                    <DialogTemplates>
                        <Content>
                            <SfTextBox Width="100%" Placeholder="Search" ShowClearButton="true" OnInput="@OnInput"></SfTextBox>
                            <hr/>
                            <div>
                                <h6>Search docs</h6>
                                <div class="search-list-wrapper">
                                    @if (isPredefinedList)
                                    {
                                        @foreach (var item in PredefinedPages)
                                        {
                                            <div class="result-item" @onclick="() => Navigate(item.Url)">
                                                <span class="sb-icons e-file-format"></span>@item.Title
                                            </div>
                                        }
                                    } 
                                    else
                                    {
                                        @foreach (var item in FilteredPages)
                                        {
                                            <div class="result-item" @onclick="() => Navigate(item.Url)">
                                                <span class="sb-icons e-file-format"></span>@item.Title
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </Content>
                    </DialogTemplates>
                    <DialogPositionData X="center" Y="top"></DialogPositionData>
                </SfDialog>

                <div class="action-buttons preferences-wrapper">
                    @if (PreferencesPopupOpen)
                    {
                        <div class="preferences-popup-backdrop" @onclick="ClosePreferencesPopup"></div>
                        <div id="preferences-popup" class="preferences-popup" role="dialog" aria-label="Preferences" @onclick:stopPropagation="true">
                            <div class="preferences-container">
                                <div>
                                    <div class="preferences-header">Preferences</div>
                                    <hr />
                                    <div>
                                        <div class="preferences-label">Mode Selection</div>
                                        <div class="btn-group mode-toggle-group">
                                            <SfButtonGroup Mode="SelectionMode.Single">
                                                <Button IconCss="sb-icons e-align-left" Selected="@(!IsRtl)" @onclick="@(() => SetRTL(false))">LTR</Button>
                                                <Button IconCss="sb-icons e-align-right" Selected="@(IsRtl)" @onclick="@(() => SetRTL(true))">RTL</Button>
                                            </SfButtonGroup>
                                        </div>
                                    </div>
                                </div>
                                <div class="render-mode-section">
                                    <ModeSwitcher isRenderModeSwitcher="true"/>
                                </div>
                                <div class="render-mode-section">
                                    <ModeSwitcher isRenderModeSwitcher="false" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!IsMobile && !IsTablet)
                {
                    <LayoutActionButtons SourceUrl="https://github.com/syncfusion/blazor-toolkit"
                                          IsDarkTheme="IsDarkTheme"
                                          OnToggleTheme="@(v => ToggleTheme(v))"
                                          ShowSettings="true"
                                          OnSettingsClick="@(_ => TogglePreferencesPopup())" />
                }
            </div>
        </div>
    </header>
    <div class="content-row">
        <div class="loader-class">
            <div class="overlay"></div>
            <div class="brand-loader">
                <div class="syncfusion-logo-large" aria-hidden="true"></div>
            </div>
        </div>
        @if (!IsMobile && !IsTablet)
        {
            <aside class="sidebar">
                <NavMenu />
            </aside>
        }

        @* Wide Layout: Apply full-width layout class for pages that opt out of the right TOC. *@
        <main class="main-area @(IsWideLayoutPage ? "main-area-full-width" : "")">
            <article class="page-content">
                <CascadingValue Value="CurrentChartTheme">
                    @* Cascade the TOC holder to @Body so the rendered page can publish its section list
                       into the same instance the right sidebar reads from. *@
                    <CascadingValue Value="@_tocHolder">
                        <SfBreadcrumb />
                        @Body
                        <PageFooter />
                    </CascadingValue>
                </CascadingValue>
            </article>
        </main>

        @* Release Notes: Right panel is visible only on desktop and tablet, and hidden on release-notes page.
           RightToc pulls the holder via [CascadingParameter] and subscribes to its Changed event directly,
           so no wrapper component is needed. The same holder instance is shared with @Body above. *@
        @* Wide Layout: Right panel is visible only on desktop and tablet, and hidden on wide-layout pages. *@
        @if (!IsMobile && !IsTablet && !IsWideLayoutPage)
        {
            <CascadingValue Value="@_tocHolder">
                <aside class="right-panel">
                    <RightToc />
                </aside>
            </CascadingValue>
        }
    </div>
</div>

@if (IsMobile || IsTablet)
{
    <div class="mobile-sidebar-backdrop @(OverlayLeftIsOpen ? "open" : string.Empty)" @onclick="OnLeftSidebarClose"></div>
    <aside id="leftSidebar" class="mobile-sidebar @(OverlayLeftIsOpen ? "open" : string.Empty) @(IsRtl ? "rtl" : string.Empty)" aria-hidden="@(!OverlayLeftIsOpen).ToString().ToLower()">
        <div class="e-top-sidebar">
            <div style="display: flex;">
                <LayoutActionButtons SourceUrl="https://gitea.syncfusion.com/essential-studio/blazor-toolkit" IsDarkTheme="IsDarkTheme" OnToggleTheme="@(v => ToggleTheme(v))" />
            </div>
            <SfButton IconCss="e-toolkit-icons e-close" CssClass="close-btn" aria-label="Close navigation" @onclick="OnLeftSidebarClose"></SfButton>
        </div>
        <div class="mobile-nav-wrapper" tabindex="0" @onkeydown="@OnSidebarKeyDown">
            <NavMenu />
        </div>
    </aside>
}

<Syncfusion.Blazor.Toolkit.Popups.SfDialogProvider/>

@code {
    // Injected services
    [Inject] NavigationManager Nav { get; set; } = default!;
    [Inject] IJSRuntime JS { get; set; } = default!;

    // Theme support
    private bool IsDarkTheme = false;
    private bool IsRtl = false;

    // Search dialog state (existing)
    private SfDialog DialogObj = default!;
    private bool isSearchVisible = false;
    private bool isPredefinedList = true;
    private bool PreferencesPopupOpen = false;

    // Responsive state: overlay left nav open and current screen size
    private bool OverlayLeftIsOpen = false; // controls the mobile overlay sidebar

    // Define breakpoints consistent with many responsive patterns: mobile <=640, tablet <=1024
    private enum ScreenSize { Mobile, Tablet, Desktop }
    private ScreenSize CurrentScreen { get; set; } = ScreenSize.Desktop;

    // Distinguish mobile vs tablet for layout differences
    private bool IsMobile => CurrentScreen == ScreenSize.Mobile;
    private bool IsTablet => CurrentScreen == ScreenSize.Tablet;

    // Compute the current Chart theme based on dark/light mode
    private Theme CurrentChartTheme => IsDarkTheme ? Theme.FluentDark : Theme.Fluent;

    // Keep a DotNetObjectReference for JS callbacks and ensure we dispose it
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    // Wide Layout: Track pages that should use full-width layout without the right TOC (e.g. Explore, Release Notes)
    private bool IsWideLayoutPage =>
        Nav.Uri.Contains("/explore", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/charts/overview", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.EndsWith("/", StringComparison.OrdinalIgnoreCase);

    // Shared holder for TOC items supplied by the current page via `[CascadingParameter] TocItemsHolder`.
    private readonly TocItemsHolder _tocHolder = new();

    private sealed class TocHeadingInfo
    {
        public string Id { get; set; } = string.Empty;

        public string Text { get; set; } = string.Empty;

        public int Level { get; set; }
    }

    // Search page lists
    public List<SearchItem> PredefinedPages { get; set; } = new()
    {
        new("Browser Support", "browser-support"),
        new("Blazor Web App", "blazor-web-app"),
        new("Blazor WebAssembly App", "blazor-webassembly-app"),
        new("Button", "buttons/button"),
        new("Calendar", "calendars/calendar"),
        new("Charts", "charts/overview")
    };

    public List<SearchItem> FilteredPages { get; set; } = new();

    // Set to true on every route change. OnAfterRenderAsync consumes
    // the flag and resets the scroll position of the .main-area
    // container AFTER the new page has rendered. Calling the JS
    // scrollToTop from LocationChanged itself is too early – the new
    // page's DOM has not been mounted yet at that point.
    private bool _pendingScrollToTop;

    // Lifecycle: subscribe to route changes.
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Set the flag and force a re-render of the layout. Without the
        // StateHasChanged call, the layout does not re-render on page
        // navigation (its parameters are unchanged) and therefore
        // OnAfterRenderAsync would not run again to consume the flag.
        _pendingScrollToTop = true;
        InvokeAsync(StateHasChanged);
    }

    // Lifecycle: register resize callback once after first render and initialize theme
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Create a DotNetObjectReference so JS can call back into this instance
            _dotNetRef = DotNetObjectReference.Create(this);

            // Disable browser's automatic scroll restoration across SPA
            // navigations. We control the scroll position ourselves.
            try
            {
                await JS.InvokeVoidAsync("scrollHelpers.initialize");
            }
            catch
            {
                // ignore - initialize is best-effort
            }

            // Ensure mainlayout.js is loaded and the responsive helper is available
            await JS.InvokeVoidAsync("mainLayout.ensureResponsive");

            // Register this instance with the helper
            await JS.InvokeVoidAsync("responsiveBlazor.register", _dotNetRef);
            try
            {
                var currentTheme = await JS.InvokeAsync<string>("mainLayout.initTheme");
                IsDarkTheme = currentTheme == "dark";
                await InvokeAsync(StateHasChanged);
            }
            catch { }

            try
            {
                var currentDir = await JS.InvokeAsync<string>("mainLayout.initDir");
                // Ensure the Syncfusion service is configured to match persisted direction on initial load
                IsRtl = string.Equals(currentDir, "rtl", StringComparison.OrdinalIgnoreCase);
                SyncfusionService.EnableRtl(IsRtl);
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }

        // Consume the scroll-to-top request queued by OnLocationChanged.
        // By waiting until OnAfterRenderAsync we are guaranteed that the
        // new page's DOM has been mounted, so resetting the scroll lands
        // on the new page rather than mid-content of the previous one.
        if (_pendingScrollToTop)
        {
            _pendingScrollToTop = false;
            try
            {
                await JS.InvokeVoidAsync("scrollHelpers.scrollToTop");
            }
            catch
            {
                // renderer may be tearing down
            }
        }

        await PopulateChartTocAsync();
    }

    private async Task PopulateChartTocAsync()
    {
        if (_tocHolder.Items is not null && _tocHolder.Items.Count > 0)
        {
            return;
        }

        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        if (!relativePath.StartsWith("charts/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            var headings = await JS.InvokeAsync<TocHeadingInfo[]>("tocScrollspy.collectHeadings", ".page-content");
            if (headings is null || headings.Length == 0)
            {
                return;
            }

            _tocHolder.Items = headings
                .Select(item => new RightToc.TocItem(item.Id, item.Text, item.Level))
                .ToArray();
        }
        catch
        {
            // Best-effort only. Pages that publish their own TOC still work.
        }
    }

    // JSInvokable: receives width and updates internal screen size state.
    [JSInvokable]
    public Task NotifyResize(int width)
    {
        // Determine new logical screen size
        var newSize = width <= 640 ? ScreenSize.Mobile : (width <= 1024 ? ScreenSize.Tablet : ScreenSize.Desktop);
        // Only trigger a render when the logical size changes to minimize re-renders
        if (newSize != CurrentScreen)
        {
            CurrentScreen = newSize;
            // When moving to desktop, ensure overlays are closed
            if (CurrentScreen == ScreenSize.Desktop)
            {
                OverlayLeftIsOpen = false;
            }
            // Request a render on the UI thread
            InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    // Toggle overlay left nav (called from hamburger button)
    private void ToggleLeftOverlay()
    {
        OverlayLeftIsOpen = !OverlayLeftIsOpen;
    }

    // Close handler for SfSidebar
    private void OnLeftSidebarClose()
    {
        OverlayLeftIsOpen = false;
    }

    // Handle keydown events inside the overlay sidebar (Escape to close)
    private void OnSidebarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            OverlayLeftIsOpen = false;
        }
    }

    // Keyboard support for hamburger: Enter/Space toggle, Escape closes
    private void OnHamburgerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            ToggleLeftOverlay();
        }
        else if (e.Key == "Escape")
        {
            OverlayLeftIsOpen = false;
        }
    }

    // Existing search helpers (unchanged semantics)
    private void ToggleSearchPopup()
    {
        isSearchVisible = true;
    }

    private void OnOverlayClick()
    {
        isSearchVisible = false;
        isPredefinedList = true;
    }

    private void OnInput(InputEventArgs args)
    {
        isPredefinedList = args.Value is null ? true : false;
        if (!string.IsNullOrEmpty(args.Value))
        {
            FilteredPages = SearchIndex.Items.Where(item => item.Title.Contains(args.Value, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else
        {
            FilteredPages = new();
        }
    }

    private async Task Navigate(string url)
    {
        Nav.NavigateTo(url);
        await Task.Delay(200);
        isSearchVisible = false;
        isPredefinedList = true;
    }

    private void TogglePreferencesPopup()
    {
        PreferencesPopupOpen = !PreferencesPopupOpen;
    }

    private void ClosePreferencesPopup()
    {
        PreferencesPopupOpen = false;
    }

    private async Task SetRTL(bool rtl)
    {
        IsRtl = rtl;
        PreferencesPopupOpen = false;
        // Update Syncfusion RTL mode immediately so components will be configured
        SyncfusionService.EnableRtl(IsRtl);
        var dir = IsRtl ? "rtl" : "ltr";
        try
        {
            await JS.InvokeVoidAsync("mainLayout.setDir", dir);
        }
        catch { }
        await InvokeAsync(StateHasChanged);
        try
        {
            Nav.NavigateTo(Urihelper.BaseUri, forceLoad: true);
        }
        catch { }
    }

    // Toggle dark/light theme: update localStorage, document class and Syncfusion theme link.
    // Accepts the desired new state from the caller (typically the SfButton's
    // OnClick handler in LayoutActionButtons) and uses it directly instead of
    // flipping the local copy. The caller (the toggle button) has already
    // computed the new value (current XOR true), so flipping again would
    // cancel the user interaction and leave the UI desynced.
    private async Task ToggleTheme(bool newValue)
    {
        // Normalize: avoid no-op work when nothing actually changes.
        if (IsDarkTheme == newValue)
        {
            return;
        }
        IsDarkTheme = newValue;
        var theme = IsDarkTheme ? "dark" : "light";
        try
        {
            await JS.InvokeVoidAsync("mainLayout.setTheme", theme);
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    private void OnDialogClose(BeforeCloseEventArgs args)
    {
        args.PreventFocus = true;
    }

    // Ensure we clean up the JS listeners and DotNetObjectReference
    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;

        try
        {
            await JS.InvokeVoidAsync("responsiveBlazor.dispose");
        }
        catch
        {
            // ignore errors during dispose
        }

        _dotNetRef?.Dispose();
    }
}

<style>
    :root {
        /* Core Colors - tuned to match the Syncfusion wordmark navy
           (the deep indigo/blue used in the "Syncfusion" logotype). */
        --bg-color: #ffffff;
        --text-color: #1f2937;
        --text-color-secondary: #6b7280;
        --top-bg: #ffffff;
        --top-text: #1f2937;
        --sidebar-bg: #ffffff;
        --panel-bg: #f9fafb;
        --scroll-bg: #ffffff;
        --accent: #2B357C;
        --accent-hover: #3B4693;
        --accent-foreground: #ffffff;
        --accent-50: #ECEEF7;
        --accent-100: #D6DBED;
        --li-hover: rgba(43, 53, 124, 0.06);
        --topsidebar-color: rgba(245,245,245,1);
        --topbar-border: rgba(15, 23, 42, 0.08);
        --topbar-search-bg: #F4F6FA;
        --topbar-search-bg-hover: #EEF1F6;

        /* Typography Scale */
        --font-family: "Inter", "Segoe UI", Roboto, system-ui, -apple-system, sans-serif;
        --font-right-sidebar: 13px;
        --font-left-sidebar: 14px;
        --font-page-title: 26px;
        --font-section-header: 18px;
        --font-body: 15px;
        --font-line-height: 1.6;
    }
    .dark {
        --bg-color: #0b1020;
        --text-color: #e5e7eb;
        --text-color-secondary: #9ca3af;
        --top-bg: #0a0f1d;
        --top-text: #e5e7eb;
        --sidebar-bg: #0a0f1d;
        --panel-bg: #0f172a;
        --scroll-bg: #0a0f1d;
        --accent: #8A93C4;
        --accent-hover: #A4ABE0;
        --accent-foreground: #001223;
        --accent-50: rgba(43, 53, 124, 0.20);
        --accent-100: rgba(43, 53, 124, 0.30);
        --li-hover: rgba(138, 147, 196, 0.18);
        --topsidebar-color: rgba(21,21,33,1);
        --topbar-border: rgba(255, 255, 255, 0.08);
        --topbar-search-bg: #0F172A;
        --topbar-search-bg-hover: #131c2f;
    }

    /* RTL helper: document root will receive `dir=rtl` and `.rtl` class */
    .rtl {
        direction: rtl;
    }

    .sf-breadcrumb ol {
        list-style: none; display: flex; flex-wrap: wrap;
        align-items: center; gap: 8px; padding: 0; margin: 0;
        font-size: 14px; color: var(--text-color-secondary);
    }
    .sf-breadcrumb li { display: inline-flex; align-items: center; gap: 6px; margin: unset; }
    .sf-breadcrumb a {
        display: inline-flex; align-items: center; gap: 6px;
        color: var(--text-color-secondary); text-decoration: none;
        padding: 4px 6px; border-radius: 4px;
        transition: color .15s ease, background-color .15s ease;
    }
    .sf-breadcrumb a:hover {
        color: var(--text-color);
        background: var(--li-hover);
        text-decoration: none;
    }
    .sf-breadcrumb a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }
    .sf-breadcrumb-sep {
        color: var(--text-color-secondary);
        opacity: .55;
        user-select: none;
    }
    .sf-breadcrumb-current {
        color: var(--text-color);
        font-weight: 600;
        padding: 4px 6px;
    }

    /* Page-level colors */
    .page {
        background-color: var(--bg-color);
        color: var(--text-color);
        min-height: 100vh;
        transition: background-color .2s ease, color .2s ease;
    }

    /* Top layout */
    .top-layout-custom {
        background-color: var(--top-bg);
        color: var(--top-text);
        transition: background-color .2s ease, color .2s ease;
    }
    .top-layout-custom .github a,
    .e-sidebar .github a,
    .e-top-sidebar .github a {
        color: var(--top-text);
        font-weight: bold;
        margin-top: 7px;
    }

    /* Sidebars */
    .sidebar,
    .mobile-sidebar {
        background-color: var(--sidebar-bg);
        color: var(--text-color);
        transition: background-color .2s ease, color .2s ease;
    }
    .mobile-sidebar-backdrop {
        position: fixed;
        inset: 0;
        z-index: 998;
        background: rgba(0, 0, 0, 0.28);
        opacity: 0;
        pointer-events: none;
        transition: opacity .2s ease;
    }
    .dark .mobile-sidebar-backdrop {
        background: rgba(0, 0, 0, 0.45);
    }
    .mobile-sidebar-backdrop.open {
        opacity: 1;
        pointer-events: auto;
    }
    .mobile-sidebar {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        width: 260px;
        z-index: 999;
        transform: translateX(-100%);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        overflow-y: auto;
        border-inline-end: 1px solid rgba(0, 0, 0, 0.08);
    }
    .mobile-sidebar.open {
        transform: translateX(0);
    }
    .mobile-sidebar.rtl {
        left: auto;
        right: 0;
        transform: translateX(100%);
        border-inline-end: 0;
        border-inline-start: 1px solid rgba(0, 0, 0, 0.08);
    }
    .mobile-sidebar.rtl.open {
        transform: translateX(0);
    }

    /* Navigation links */
    .sidebar .nav-link,
    .sidebar .menu-summary {
        color: var(--text-color);
    }

    .content-row {
        display: flex;
        min-height: calc(100vh - 64px);
    }

    .sidebar {
        min-width: 280px;
        flex-shrink: 0;
        border-inline-end: 1px solid rgba(0, 0, 0, 0.06);
    }

    .main-area {
        flex: 1;
        width: 100%;
        max-width: 100%;
        padding: 36px 48px;
        background-color: var(--bg-color);
    }

    @@media (min-width: 1025px) {
        .main-area {
            max-width: calc(100% - 500px);
