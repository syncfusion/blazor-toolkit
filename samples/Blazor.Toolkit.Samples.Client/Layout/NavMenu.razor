@code {
    private string _relativeUri = string.Empty;
    private bool _firstRender = true;

    private bool _chartsSectionsExpanded = false;
    private string _singleCategory = string.Empty;

    private bool _componentsExpanded = false;

    protected override void OnInitialized()
    {
        _relativeUri = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri)
            .Trim('/');

        if (string.IsNullOrEmpty(_singleCategory) &&
            (_relativeUri.Equals("charts", StringComparison.OrdinalIgnoreCase) ||
            _relativeUri.StartsWith("charts/", StringComparison.OrdinalIgnoreCase)))
        {
            _singleCategory = "charts";
        }

        _chartsSectionsExpanded =
            IsChartsRoute(_relativeUri) ||
            string.Equals(_singleCategory, "charts",
                StringComparison.OrdinalIgnoreCase);

        // Auto-expand the Components group when a route inside it is active
        _componentsExpanded = IsComponentsRoute(_relativeUri) || _componentsExpanded;

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _firstRender = false; }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(
    object? sender,
    Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _relativeUri = NavigationManager
            .ToBaseRelativePath(e.Location)
            .Trim('/');

        if (string.IsNullOrEmpty(_singleCategory))
        {
            if (_relativeUri.Equals("charts", StringComparison.OrdinalIgnoreCase) ||
                _relativeUri.StartsWith("charts/", StringComparison.OrdinalIgnoreCase))
            {
                _singleCategory = "charts";
            }
        }
        else
        {
            if (!(_relativeUri.Equals(_singleCategory, StringComparison.OrdinalIgnoreCase) ||
                _relativeUri.StartsWith(_singleCategory + "/", StringComparison.OrdinalIgnoreCase)))
            {
                _singleCategory = string.Empty;
            }
        }

        _chartsSectionsExpanded =
            IsChartsRoute(_relativeUri) ||
            string.Equals(_singleCategory, "charts",
                StringComparison.OrdinalIgnoreCase);

        // Keep the Components group expanded when a route inside it is active
        if (IsComponentsRoute(_relativeUri))
        {
            _componentsExpanded = true;
        }

        InvokeAsync(StateHasChanged);
    }

    private bool IsGroupOpen(params string[] prefixes)
    {
        if (prefixes is null || prefixes.Length == 0) return false;
        foreach (var prefix in prefixes)
        {
            var p = prefix?.Trim('/') ?? string.Empty;
            if (string.IsNullOrEmpty(p)) continue;
            if (_relativeUri.Equals(p, StringComparison.OrdinalIgnoreCase)) return true;
            if (_relativeUri.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private void ShowCategory(string category)
    {
        // Ensure the parent Components group is open when entering a category
        _componentsExpanded = true;

        _singleCategory = category ?? string.Empty;

        _chartsSectionsExpanded =
            string.Equals(category, "charts",
                StringComparison.OrdinalIgnoreCase);

        if (string.Equals(category, "charts",
                StringComparison.OrdinalIgnoreCase))
        {
            NavigationManager.NavigateTo("charts/overview");
        }

        InvokeAsync(StateHasChanged);
    }

    private void ShowAll()
    {
        _singleCategory = string.Empty;
        _chartsSectionsExpanded = false;

        InvokeAsync(StateHasChanged);
    }

    // Toggles the expand/collapse state of the "Components" group
    // in the sidebar. The <button> click handler flips the bound
    // field; the @if below reads the same field to render the items.
    private void ToggleComponents()
    {
        _componentsExpanded = !_componentsExpanded;
    }

    private string GetChartsLinkClass()
    {
        return string.Equals(_singleCategory, "charts",
            StringComparison.OrdinalIgnoreCase)
                ? "sf-nav-link active"
                : "sf-nav-link";
    }

    private static bool IsChartsRoute(string relativeUri)
    {
        if (string.IsNullOrWhiteSpace(relativeUri))
        {
            return false;
        }

        return relativeUri.Equals(
                "charts",
                StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith(
                "charts/",
                StringComparison.OrdinalIgnoreCase);
    }

    // Returns true when the current route is one of the entries shown
    // inside the "Components" group. Used to auto-expand the group
    // when a deep link lands on a child page.
    private static bool IsComponentsRoute(string relativeUri)
    {
        if (string.IsNullOrWhiteSpace(relativeUri))
        {
            return false;
        }

        return relativeUri.Equals("charts", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("charts/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.Equals("buttons", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("buttons/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.Equals("calendars", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("calendars/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.Equals("spinner", StringComparison.OrdinalIgnoreCase)
            || relativeUri.Equals("inputs", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("inputs/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.Equals("popups", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("popups/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAnyGroupOpen(params string[] prefixes)
    {
        if (prefixes is null || prefixes.Length == 0)
        {
            return false;
        }

        foreach (var prefix in prefixes)
        {
            if (IsGroupOpen(prefix))
            {
                return true;
            }
        }

        return false;
    }

    // Returns true when the current URL exactly matches the given href
    // (case-insensitive). Used to highlight a single <li> independently
    // rather than the whole parent group.
    private bool IsActive(string? href)
    {
        if (string.IsNullOrEmpty(href)) return false;
        return string.Equals(_relativeUri, href.Trim('/'), StringComparison.OrdinalIgnoreCase);
    }
}
