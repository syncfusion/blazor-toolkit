@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Nav

@* Public nested record so consumers can declare their own TocItemList
   without needing a separate file. Pages use RightToc.TocItem. *@

@*
    Right-sidebar Table of Contents.

    Subscribes to the cascading TocItemsHolder.Changed event (in
    OnParametersSet, since CascadingParameter values are not yet
    populated during OnInitialized) so the sidebar re-renders the instant
    a page publishes or clears its items. Items are read directly from
    the holder each render so MainLayout does not need to pass them as a
    parameter. Renders a flat list of sub-topics (no nested groups, no
    page title). Only the item matching the URL hash OR the active id
    reported by the scroll-spy is marked .visible.
*@

@{
    // Base-relative path (e.g. "/buttons/button-group") so anchor hrefs
    // resolve to "<current-page>#<id>" rather than the absolute URL.
    var basePath = "/";
    try
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        var hashIndex = relative.IndexOf('#');
        var queryIndex = relative.IndexOf('?');
        var cut = (hashIndex, queryIndex) switch
        {
            ( >= 0, >= 0) => Math.Min(hashIndex, queryIndex),
            ( >= 0, < 0) => hashIndex,
            ( < 0, >= 0) => queryIndex,
            _ => -1
        };
        basePath = cut >= 0 ? relative.Substring(0, cut) : relative;

        // ToBaseRelativePath returns the path WITHOUT a leading slash
        // (e.g. "buttons/button-group"). Normalize so href values are
        // rooted and resolve correctly when middle-clicked.
        if (string.IsNullOrEmpty(basePath))
        {
            basePath = "/";
        }
        else if (!basePath.StartsWith('/'))
        {
            basePath = "/" + basePath;
        }
    }
    catch
    {
        // Defensive: prerender or test environments may not expose Uri.
    }
}

<div class="right-toc">
    <div class="toc-inner">
        <h6 class="toc-heading"><b>On this page</b></h6>
        @if (EffectiveItems is null || EffectiveItems.Count == 0)
        {
            // Render nothing when the page has no headings.
        }
        else
        {
            <ul class="toc-tree" role="tree">
                @foreach (var item in EffectiveItems)
                {
                    if (string.IsNullOrEmpty(item.Id))
                    {
                        continue;
                    }
                    <li class="toc-tree-item level-@item.Level" role="treeitem">
                        <a class="toc-tree-link @(IsActive(item.Id) ? "visible" : "")"
                           href="@(basePath + "#" + item.Id)"
                           aria-current="@(IsActive(item.Id) ? "location" : null)"
                           @onclick="@(async () => await ScrollToAsync(item.Id))"
                           @onclick:preventDefault="true">@item.Text</a>
                    </li>
                }
            </ul>
        }

        @* ============================================================
           STATIC "NEED HELP?" CARD
           ============================================================ *@
        <section class="sf-help-card" aria-label="Need help">
            <h6 class="sf-help-title">Need help?</h6>
            <p class="sf-help-desc">
                Ask questions, share ideas, or report issues for
                Syncfusion Blazor Toolkit.
            </p>

            <ul class="sf-help-links" role="list">
                <li>
                    <a class="sf-help-link"
                       href="https://github.com/syncfusion/blazor-toolkit/issues"
                       target="_blank"
                       rel="noreferrer noopener"
                       aria-label="GitHub Issues (opens in a new tab)">
                        <span>GitHub Issues</span>
                        <svg class="sf-help-link-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                    </a>
                </li>
            </ul>

            <a class="sf-help-btn"
               href="https://github.com/syncfusion/blazor-toolkit/discussions"
               target="_blank"
               rel="noreferrer noopener"
               aria-label="Visit Discussions (opens in a new tab)">
                <span aria-hidden="true">💬</span>
                <span>Visit Discussions</span>
            </a>
        </section>
    </div>
</div>

@code {
    /// <summary>
    /// Optional explicit items override. When null, items are read from
    /// the cascading <see cref="TocItemsHolder"/> on every render.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TocItem>? Items { get; set; }

    /// <summary>
    /// Cascading holder. When present, the component subscribes to
    /// <see cref="TocItemsHolder.Changed"/> (in OnParametersSet) and
    /// reads <see cref="TocItemsHolder.Items"/> on every render.
    /// </summary>
    [CascadingParameter]
    private TocItemsHolder? Holder { get; set; }

    // Tracks the holder instance we are currently subscribed to so we
    // re-subscribe only when the cascade hands us a new instance, and
    // unsubscribe cleanly on disposal.
    private TocItemsHolder? _subscribedHolder;

    private string? _activeId;
    private DotNetObjectReference<RightToc>? _dotNetRef;
    private bool _disposed;

    /// <summary>
    /// A single entry in the right-sidebar Table of Contents treeview.
    /// </summary>
    /// <param name="Id">
    /// The DOM id of the heading this entry links to. MUST match the
    /// <c>id="..."</c> attribute on the corresponding <c>&lt;h4&gt;</c> or
    /// <c>&lt;h5&gt;</c> heading in the Razor page.
    /// </param>
    /// <param name="Text">The visible text of the heading, as rendered in the sidebar.</param>
    /// <param name="Level">
    /// The heading level. Defaults to <c>5</c> for subsection headings.
    /// The sidebar uses this to indent the item via the <c>level-N</c> class.
    /// </param>
    public sealed record TocItem(string Id, string Text, int Level = 5);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // CascadingParameter values are not populated during OnInitialized,
        // so subscription must happen here. Re-subscribe only when the
        // holder instance actually changes (it normally does not, but
        // defending against it keeps the component robust).
        if (!ReferenceEquals(_subscribedHolder, Holder))
        {
            if (_subscribedHolder is not null)
            {
                _subscribedHolder.Changed -= OnHolderChanged;
            }

            _subscribedHolder = Holder;

            if (_subscribedHolder is not null)
            {
                _subscribedHolder.Changed += OnHolderChanged;
            }
        }
    }

    private void OnHolderChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string? id) =>
        !string.IsNullOrEmpty(id) && string.Equals(_activeId, id, StringComparison.Ordinal);

    // Items are sourced from the holder each render; an explicit
    // [Parameter] override still wins so the component is testable.
    private IReadOnlyList<TocItem>? EffectiveItems =>
        Items ?? Holder?.Items;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (firstRender && _dotNetRef is null)
        {
            _dotNetRef = DotNetObjectReference.Create(this);

            // Seed the active id from the URL hash so the user lands with
            // the matching item already highlighted, even before the
            // scroll-spy reports the first visible heading.
            var initialId = ExtractHashId(Nav.Uri);
            if (!string.IsNullOrEmpty(initialId))
            {
                _activeId = initialId;
            }
        }

        // Re-observe the current heading ids on every render. The Holder
        // raises Changed whenever a page publishes (or clears) its items,
        // which re-runs OnAfterRenderAsync, which re-observes the new
        // heading ids and disconnects the previous observer. The
        // scrollspy.observe JS function handles its own cleanup.
        var effective = EffectiveItems;
        if (_dotNetRef is not null && effective is { Count: > 0 })
        {
            var ids = effective.Select(s => s.Id).Where(id => !string.IsNullOrEmpty(id)).ToArray();
            try
            {
                await JS.InvokeVoidAsync("tocScrollspy.observe", ids, _dotNetRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
                // Renderer not interactive yet (prerender phase).
            }
        }
    }

    private static string? ExtractHashId(string? uri)
    {
        if (string.IsNullOrEmpty(uri))
        {
            return null;
        }

        var hashIndex = uri.IndexOf('#');
        if (hashIndex < 0 || hashIndex == uri.Length - 1)
        {
            return null;
        }

        var fragment = uri.Substring(hashIndex + 1);
        // Strip a query string in the fragment portion (rare but valid).
        var qIndex = fragment.IndexOf('?');
        if (qIndex >= 0)
        {
            fragment = fragment.Substring(0, qIndex);
        }

        return string.IsNullOrEmpty(fragment) ? null : fragment;
    }

    private async Task ScrollToAsync(string id)
    {
        if (string.IsNullOrEmpty(id))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("tocScrollspy.scrollToId", id);
            if (!string.Equals(_activeId, id, StringComparison.Ordinal))
            {
                _activeId = id;
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    [JSInvokable]
    public Task NotifyActiveId(string id)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        if (string.Equals(_activeId, id, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _activeId = id;
        return InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;

        if (_subscribedHolder is not null)
        {
            _subscribedHolder.Changed -= OnHolderChanged;
            _subscribedHolder = null;
        }

        try
        {
            await JS.InvokeVoidAsync("tocScrollspy.disconnect");
        }
        catch
        {
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
