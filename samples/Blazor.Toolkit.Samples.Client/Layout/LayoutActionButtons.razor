@using Syncfusion.Blazor.Toolkit.Buttons
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Nav


@code {
    /// <summary>
    /// URL the GitHub-style icon button navigates to. Pass the public
    /// GitHub mirror or the internal Gitea URL depending on context.
    /// </summary>
    [Parameter, EditorRequired]
    public string SourceUrl { get; set; } = string.Empty;

    /// <summary>
    /// True when the dark theme is active. Bound to the theme toggle
    /// button's checked state.
    /// </summary>
    [Parameter, EditorRequired]
    public bool IsDarkTheme { get; set; }

    /// <summary>
    /// Handler invoked when the user toggles the theme button. Receives
    /// the desired new state (true = dark, false = light). Bound to
    /// <c>MainLayout.ToggleTheme</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<bool, Task> OnToggleTheme { get; set; } = default!;

    /// <summary>
    /// When true, the Settings button is rendered between GitHub and
    /// the theme toggle. Set to true in the desktop header where the
    /// preferences popup is mounted, false in the mobile sidebar
    /// header where the popup is not shown.
    /// </summary>
    [Parameter]
    public bool ShowSettings { get; set; }

    /// <summary>
    /// Click handler for the Settings button. Bound to
    /// <c>MainLayout.TogglePreferencesPopup</c> when <see cref="ShowSettings"/>
    /// is true. Ignored otherwise.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnSettingsClick { get; set; }

    // Shared CSS class applied to every button in the group. The
    // "e-round" form factor makes the button circular (icon-only
    // shape), and "topbar-icon" carries the size, padding and
    // hover/focus styling that matches the rest of the top header.
    // "topbar-theme" hooks the active/checked state styling.
    private const string TopbarIconCss = "e-round e-outline topbar-icon";

    private async Task OnThemeChanged(MouseEventArgs _)
    {
        // On a SfButton with IsToggle="true" the toolkit manages the
        // checked state internally and raises `OnClick` on every click.
        // We forward the FLIPPED state to the parent so the parent
        // (and JS) stay in sync with what the button already shows.
        // The parent uses this value as the new authoritative state
        // (no further flipping).
        if (OnToggleTheme is not null)
        {
            await OnToggleTheme(!IsDarkTheme);
        }
    }

    // The GitHub button is an outbound link. The SfButton.OnClick
    // signature is MouseEventArgs -> Task; we navigate via JS-free
    // NavigationManager so the link opens in a new tab like the
    // previous <a target="_blank"> behaviour.
    private async Task OnGithubClick(MouseEventArgs _)
    {
        // Force-load: false so we don't trigger a full app reload, but
        // we still want a new browser tab. The anchor with target="_blank"
        // approach is not available on SfButton, so we round-trip
        // through JS interop.
        await Task.CompletedTask;
        Nav.NavigateTo(SourceUrl, forceLoad: true);
    }
}

<div class="topbar-icon-group">
    @if (ShowSettings)
    {
        <SfButton CssClass="@TopbarIconCss"
                   IconCss="sb-icons e-settings"
                   title="Settings"
                   aria-label="Settings"
                   OnClick="@OnSettingsClick" />
    }
    <SfButton CssClass="@TopbarIconCss"
               title="View source on GitHub"
               aria-label="View source on GitHub"
               OnClick="@OnGithubClick">
        <svg class="topbar-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.55C20.21 21.38 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5Z" />
        </svg>
    </SfButton>
    <SfButton CssClass="@($"{TopbarIconCss} topbar-theme {(IsDarkTheme ? "is-active" : string.Empty)}")"
               title="@(IsDarkTheme ? "Switch to light theme" : "Switch to dark theme")"
               aria-label="Toggle theme"
               IsToggle="true"
               OnClick="@OnThemeChanged">
        @if (IsDarkTheme)
        {
            <svg class="topbar-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
        }
        else
        {
            <svg class="topbar-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
            </svg>
        }
    </SfButton>
</div>
